{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "graftFixturePassword",
      "type": "promptString",
      "description": "Temporary password for the legacy UI probe (16-256 characters)",
      "password": true
    }
  ],
  "configurations": [
    {
      "name": "Debug production browser fixture",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build browser fixture",
      "program": "${workspaceFolder}/tests/Graft.Browser.Fixture/bin/Debug/net10.0/Graft.Browser.Fixture.dll",
      "args": [
        "${workspaceFolder}/src/Graft.Server/bin/Debug/net10.0/Graft.Server.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "READY:\\s+(https://127\\.0\\.0\\.1:[0-9]+/projects)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Debug project pages",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build browser fixture",
      "program": "${workspaceFolder}/tests/Graft.Browser.Fixture/bin/Debug/net10.0/Graft.Browser.Fixture.dll",
      "args": [
        "${workspaceFolder}/src/Graft.Server/bin/Debug/net10.0/Graft.Server.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "PAGE:\\s+(https://127\\.0\\.0\\.1:[0-9]+/-/p/page-only)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "Debug MVP-04 accounts and permissions",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MVP-04 acceptance",
      "program": "${workspaceFolder}/tests/Graft.Acceptance/bin/Debug/net10.0/Graft.Acceptance.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug MVP-06 repository UI and API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MVP-06 repository acceptance",
      "program": "${workspaceFolder}/tests/Graft.Git.Acceptance/bin/Debug/net10.0/Graft.Git.Acceptance.dll",
      "args": [
        "${workspaceFolder}/src/Graft.Server/bin/Debug/net10.0/Graft.Server.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug MVP-07 import and recovery",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MVP-07 acceptance and tools",
      "program": "${workspaceFolder}/tests/Graft.Operations.Acceptance/bin/Debug/net10.0/Graft.Operations.Acceptance.dll",
      "args": [
        "${workspaceFolder}/src/Graft.Server/bin/Debug/net10.0/Graft.Server.dll",
        "${workspaceFolder}/src/Graft.Admin/bin/Debug/net10.0/Graft.Admin.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug MVP-08 interactive packaging checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MVP-08 packaging acceptance",
      "program": "${workspaceFolder}/tests/Graft.Packaging.Acceptance/bin/Debug/net10.0/Graft.Packaging.Acceptance.dll",
      "args": [
        "interactive",
        "${workspaceFolder}/src/Graft.Server/bin/Debug/net10.0/Graft.Server.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug operator TLS lifecycle",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MVP-08 packaging acceptance",
      "program": "${workspaceFolder}/tests/Graft.Packaging.Acceptance/bin/Debug/net10.0/Graft.Packaging.Acceptance.dll",
      "args": [
        "tls",
        "${workspaceFolder}/src/Graft.Server/bin/Debug/net10.0/Graft.Server.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug UI and authentication probe",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build UI probe",
      "program": "${workspaceFolder}/experiments/ui-server/bin/Debug/net10.0/Graft.Ui.Server.dll",
      "args": [
        "--fixture"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "GRAFT_UI_PROBE_PASSWORD": "${input:graftFixturePassword}"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "READY:\\s+(https://127\\.0\\.0\\.1:[0-9]+)",
        "uriFormat": "%s/projects"
      }
    },
    {
      "name": "Debug compatibility probe",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build compatibility probe",
      "program": "${workspaceFolder}/experiments/compatibility/bin/Debug/net10.0/Graft.Compatibility.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug storage migration probe",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build storage migration probe",
      "program": "${workspaceFolder}/experiments/storage/bin/Debug/net10.0/Graft.StorageProbe.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug managed Git probe (loopback, disposable)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build managed Git probe",
      "program": "${workspaceFolder}/experiments/managed-git/bin/Debug/net10.0/Graft.ManagedGit.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug managed Git acceptance client",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build managed Git acceptance client",
      "program": "${workspaceFolder}/experiments/managed-git-client/bin/Debug/net10.0/Graft.ManagedGit.Client.dll",
      "args": [
        "${workspaceFolder}/experiments/managed-git/bin/Debug/net10.0/Graft.ManagedGit.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug UI HTTP acceptance checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build UI acceptance checks",
      "program": "${workspaceFolder}/experiments/ui-checks/bin/Debug/net10.0/Graft.Ui.Checks.dll",
      "args": [
        "${workspaceFolder}/experiments/ui-server/bin/Debug/net10.0/Graft.Ui.Server.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug managed Git self-checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build managed Git probe",
      "program": "${workspaceFolder}/experiments/managed-git/bin/Debug/net10.0/Graft.ManagedGit.dll",
      "args": [
        "--self-test"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug UI session self-checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build UI probe",
      "program": "${workspaceFolder}/experiments/ui-server/bin/Debug/net10.0/Graft.Ui.Server.dll",
      "args": [
        "--self-test"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to .NET process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
