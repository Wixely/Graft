{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "wslDistribution",
      "type": "promptString",
      "description": "Existing WSL distribution with rootless Podman"
    }
  ],
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "Graft.slnx",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build MVP-04 acceptance",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "tests/Graft.Acceptance/Graft.Acceptance.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build MVP-06 repository acceptance",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "tests/Graft.Git.Acceptance/Graft.Git.Acceptance.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build MVP-07 operations acceptance",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "tests/Graft.Operations.Acceptance/Graft.Operations.Acceptance.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build MVP-08 packaging acceptance",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "tests/Graft.Packaging.Acceptance/Graft.Packaging.Acceptance.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run pinned glab acceptance in WSL",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tests/Graft.Glab.Acceptance/run.ps1",
        "-Distribution",
        "${input:wslDistribution}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Graft admin",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "src/Graft.Admin/Graft.Admin.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build MVP-07 acceptance and tools",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build MVP-07 operations acceptance",
        "build Graft admin"
      ],
      "problemMatcher": []
    },
    {
      "label": "build compatibility probe",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "experiments/compatibility/Graft.Compatibility.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build storage migration probe",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "experiments/storage/Graft.StorageProbe.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build managed Git probe",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "experiments/managed-git/Graft.ManagedGit.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build managed Git acceptance client",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "experiments/managed-git-client/Graft.ManagedGit.Client.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build UI probe",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "experiments/ui-server/Graft.Ui.Server.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build UI checks client",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "experiments/ui-checks/Graft.Ui.Checks.csproj",
        "-c",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build UI acceptance checks",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build UI probe",
        "build UI checks client"
      ],
      "problemMatcher": []
    }
  ]
}
