<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishAot Condition="'$(GitProbeAot)' == 'true'">true</PublishAot>
    <PublishIISAssets>false</PublishIISAssets>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(GitProbeAot)' == 'true'">packages.$(RuntimeIdentifier).native.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Content Update="NuGet.config" CopyToPublishDirectory="Never" />
    <ProjectReference Include="../../src/Graft.Git/Graft.Git.csproj" />
  </ItemGroup>
</Project>
