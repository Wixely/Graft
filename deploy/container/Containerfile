FROM mcr.microsoft.com/dotnet/runtime-deps:10.0-noble-chiseled-extra

# artifacts/container holds the static Linux forge and admin tool as Graft.Server and Graft.Admin, and downloads/ the
# runner and git-remote-graft executables for every platform, under the names the forge's install scripts ask for. The
# release workflow lays it out from a release's files; docs/deployment.md shows how to do the same by hand.
WORKDIR /app
COPY --chown=1654:1654 --chmod=0755 artifacts/container/Graft.Server artifacts/container/Graft.Admin /app/
COPY --chown=1654:1654 --chmod=0755 artifacts/container/downloads/ /app/downloads/

COPY --chown=1654:1654 deploy/container/data/ /data/
COPY --chown=1654:1654 deploy/container/secrets/ /run/secrets/

USER 1654:1654
ENV TMPDIR=/data/temporary
# The forge, and when enabled its Model Context Protocol endpoint at /mcp, on the one port.
EXPOSE 8443
VOLUME ["/data"]
ENTRYPOINT ["/app/Graft.Server"]
