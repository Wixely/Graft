# Copy to .env beside compose.yaml and fill in. Never commit the filled copy: .env is ignored on purpose.
#
# Every value below is the closed answer. Nothing here needs changing to run a private forge; each variable
# that widens access is listed with what it costs.

# What the image is called. Compose tags what it builds with this and runs exactly that, so a separately
# built image of the same name is used rather than ignored. Set it to a registry path to push and pull one.
GRAFT_IMAGE=graft:local

# The public origin browsers use. Must match a subject alternative name on the certificate.
GRAFT_ORIGIN=https://graft.example.internal:8443

# Operator TLS material. Both files must be readable by UID 1654, the identity the container runs as:
# compose mounts secrets as host bind mounts, so the file's own permissions are what the container sees.
GRAFT_TLS_CERTIFICATE=/operator/path/tls.pfx
GRAFT_TLS_PASSWORD_FILE=/operator/path/tls-password

# Forge behaviour. All off by default; see docs/decisions/0006-project-pages-and-public-browsing.md and
# 0007-push-to-create.md for what the first two open up, and 0009-mcp-in-the-forge.md for the third.
GRAFT_PUBLIC_BROWSING=false
GRAFT_PUSH_TO_CREATE=false

# Whether the forge serves its Model Context Protocol endpoint at /mcp, on the same port and certificate as
# everything else. This is the operator's gate. With it on, an administrator decides in the browser, under
# Administration, Agent access, whether agents are served, whether they may change anything, and whether
# callers with no token are served at all; those switches default to serving, no writes, and no anonymous
# callers, and changing them needs no restart. Every caller sends their own Graft token.
GRAFT_MCP=false

# Where project sites are served, on a hostname of their own. Empty means no sites at all. Repository HTML
# cannot share an origin with the session cookie and the API, so a site needs a second hostname pointed at
# this same server; see docs/project-pages.md. The published port and certificate are shared.
GRAFT_PAGES_ORIGIN=

# Whether a token's secret stays readable after it is issued, so a lost one can be copied again rather than
# replaced. Off by default, and off is the only state in which a leaked database is not a leaked set of
# credentials. See docs/decisions/0012-recoverable-tokens.md before turning this on.
GRAFT_RECOVERABLE_TOKENS=false

# How long a signed-in browser stays signed in without being used, renewed by use, in minutes.
GRAFT_SESSION_MINUTES=720

GRAFT_MEMORY_LIMIT=2G
