# Copy to .env beside compose.yaml and fill in. Never commit the filled copy: .env is ignored on purpose.
#
# Every value below is the closed answer. Nothing here needs changing to run a private forge; each variable
# that widens access is listed with what it costs.

# The public origin browsers use. Must match a subject alternative name on the certificate.
GRAFT_ORIGIN=https://graft.example.internal:8443

# The hostname the containers use to reach the forge on the compose network. Must also match a subject
# alternative name, because the MCP service verifies the certificate rather than trusting the service name.
GRAFT_INTERNAL_HOST=graft.example.internal

# Operator TLS material. Both files must be readable by UID 1654, the identity the containers run as:
# compose mounts secrets as host bind mounts, so the file's own permissions are what the container sees.
GRAFT_TLS_CERTIFICATE=/operator/path/tls.pfx
GRAFT_TLS_PASSWORD_FILE=/operator/path/tls-password

# Forge behaviour. Both off by default; see docs/decisions/0006-project-pages-and-public-browsing.md and
# 0007-push-to-create.md for what each one opens up.
GRAFT_PUBLIC_BROWSING=false
GRAFT_PUSH_TO_CREATE=false

# How long a signed-in browser stays signed in without being used, renewed by use, in minutes.
GRAFT_SESSION_MINUTES=720

# Resource ceilings. Raise if a large repository needs it; the forge's own object budgets are much smaller.
GRAFT_MEMORY_LIMIT=512M
GRAFT_MCP_MEMORY_LIMIT=256M

# ---------------------------------------------------------------------------------------------------------
# Everything below applies only with `docker compose --profile mcp`.
# ---------------------------------------------------------------------------------------------------------

# The forge's certificate in PEM or DER, which the MCP service trusts to verify the forge. Extract the
# public half from the PKCS#12, never the private key:
#   openssl pkcs12 -in tls.pfx -clcerts -nokeys -out graft-ca.pem -passin file:tls-password
GRAFT_CA_CERTIFICATE=/operator/path/graft-ca.pem

# Whether agents reaching the MCP endpoint may change anything. Reads work either way. Each caller still
# sends their own Graft token, so this bounds every caller rather than any one of them.
GRAFT_MCP_ALLOW_WRITES=false

# Whether callers who present no credential at all are served. Leave false unless you mean it: with it on,
# anyone who can reach the port talks to Graft as a stranger. They see only public projects, which is a real
# limit, but it is the only limit.
GRAFT_MCP_ALLOW_ANONYMOUS=false
