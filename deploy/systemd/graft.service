[Unit]
Description=Graft private Git forge
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=@USER@
Group=@GROUP@
ExecStart=@EXECUTABLE@ --database @DATABASE@ --repositories @REPOSITORIES@ --listen @LISTEN@ --origin @ORIGIN@ --certificate @CERTIFICATE@ --certificate-password-file @CERTIFICATE_PASSWORD_FILE@
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=@DATA_DIRECTORY@
WorkingDirectory=@INSTALL_DIRECTORY@
Environment="TMPDIR=@DATA_DIRECTORY@/temporary"

[Install]
WantedBy=multi-user.target
