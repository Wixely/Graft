@page "/-/admin/runners"
@inject GraftApi Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The runners this forge knows, and the place to make a new one. Making one hands over, once, the two install
   scripts that carry the forge's Intonation and a one-time registration token: copy the right one to the
   machine that will run jobs and run it there. *@

<PageTitle>Runners &middot; Graft</PageTitle>

@if (loading)
{
    <p role="status" class="secondary-text">Loading…</p>
}
else if (!Api.IsAdministrator)
{
    <div class="page-header"><div><h1>Administration</h1><p class="subtitle">This page requires an administrator account.</p></div></div>
}
else
{
    <div class="page-header">
        <div>
            <h1>Runners</h1>
            <p class="subtitle">Machines that run pipeline jobs. Each reaches this forge over CupriNet from the link in its install script.</p>
        </div>
    </div>

    <Banner Message="@message" Kind="@messageKind" />

    <div class="panel">
        <div class="panel-header"><h2>New runner</h2></div>
        <div class="panel-body">
            <form class="form" @onsubmit="Create" @onsubmit:preventDefault>
                <label for="runner-description">Description</label>
                <input id="runner-description" @bind="description" maxlength="200" placeholder="build box in the office" />
                <label for="runner-tags">Tags</label>
                <input id="runner-tags" @bind="tags" maxlength="1300" placeholder="windows, android" />
                <p class="field-hint">
                    Optional, separated by commas. A job that lists <span class="mono">tags:</span> runs only on a runner that has every one of them.
                </p>
                <label class="checkbox"><input type="checkbox" @bind="runUntagged" /> Also run jobs that list no tags</label>
                <div class="form-actions">
                    <button type="submit" disabled="@busy">@(busy ? "Creating…" : "Create runner and install scripts")</button>
                </div>
            </form>
        </div>
    </div>

    @if (created is not null)
    {
        <div class="panel">
            <div class="panel-header"><Icon Name="key" /><h2>Install runner #@created.Id</h2></div>
            <div class="panel-body">
                <div class="banner warning">
                    <Icon Name="alert" />
                    <span>
                        Shown once. Each script holds a registration token, usable once until
                        @created.TokenExpiresAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"). Run it on the machine that will run jobs:
                        as an administrator on Windows, or as root on Linux, to install a service.
                    </span>
                </div>
                <p class="secondary-text">The forge answers runners as <span class="mono">@created.ShrineAddress</span>.</p>
                <div class="form-actions">
                    <button type="button" @onclick='() => Copy(created.InstallPowerShell, "ps1")'>
                        <Icon Name="@(copied == "ps1" ? "check" : "copy")" />Copy the Windows script (install-graft-runner.ps1)
                    </button>
                    <button type="button" class="secondary" @onclick='() => Copy(created.InstallShell, "sh")'>
                        <Icon Name="@(copied == "sh" ? "check" : "copy")" />Copy the Linux script (install-graft-runner.sh)
                    </button>
                </div>
                @if (failed)
                {
                    <p class="field-hint danger-text">The clipboard refused the copy. The scripts are below; select and copy one yourself.</p>
                    <label for="script-ps1">Windows</label>
                    <textarea id="script-ps1" readonly rows="8" class="mono">@created.InstallPowerShell</textarea>
                    <label for="script-sh">Linux</label>
                    <textarea id="script-sh" readonly rows="8" class="mono">@created.InstallShell</textarea>
                }
                <p class="field-hint">
                    Windows: <span class="mono">powershell -ExecutionPolicy Bypass -File install-graft-runner.ps1</span>.
                    Linux: <span class="mono">sh install-graft-runner.sh</span>.
                    Add <span class="mono">-NoService</span> or <span class="mono">--no-service</span> to register without installing a service.
                </p>
                <div class="form-actions"><button type="button" class="secondary" @onclick="Dismiss">Done</button></div>
            </div>
        </div>
    }

    <div class="panel">
        <div class="panel-header">
            <Icon Name="settings" /><h2>Runners</h2><span class="spacer"></span>
            @if (runners.Count(runner => runner.UpdateStatus == "available") > 1)
            {
                <button type="button" class="secondary" @onclick="UpdateAll" disabled="@busy">Update all</button>
            }
            <span class="label">@runners.Length</span>
        </div>
        @if (runners.Length == 0)
        {
            <p class="panel-empty">No runners yet.</p>
        }
        else
        {
            <div class="list">
                @foreach (RunnerResponse runner in runners)
                {
                    <div class="list-item">
                        <Icon Name="settings" />
                        <span class="list-item-main">
                            <strong>#@runner.Id @(runner.Name ?? runner.Description)</strong>
                            <small>
                                @(runner.Description.Length > 0 ? runner.Description + " · " : "")@(runner.Platform ?? "not registered yet")
                                @(runner.ContactedAt is DateTimeOffset contacted ? " · last seen " + contacted.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "")
                            </small>
                            <small>
                                @(runner.TagList is { Length: > 0 } runnerTags ? "Tags " + string.Join(", ", runnerTags) : "No tags")
                                @(runner.RunUntagged ? " · runs untagged jobs" : " · tagged jobs only")
                            </small>
                            @if (runner.UpdateStatus is not null)
                            {
                                <small>@(runner.Version is { Length: > 0 } version ? "Version " + version + " · " : "")@UpdateText(runner)</small>
                            }
                            @if (runner.UpdateError is { Length: > 0 } updateError)
                            {
                                <small class="danger-text">The last update did not happen: @updateError</small>
                            }
                        </span>
                        <span class="label @(runner.Online ? "success" : "")">@StatusText(runner.Status)</span>
                        <span class="list-item-actions">
                            @if (runner.UpdateStatus == "available")
                            {
                                <button type="button" class="secondary" @onclick="() => RequestUpdate(runner)" disabled="@busy">Update</button>
                            }
                            else if (runner.UpdateStatus == "requested")
                            {
                                <button type="button" class="secondary" @onclick="() => CancelUpdate(runner)" disabled="@busy">Cancel update</button>
                            }
                            <button type="button" class="secondary" @onclick="() => StartEdit(runner)" disabled="@busy">Edit tags</button>
                            <button type="button" class="@(pendingDelete == runner.Id ? "danger" : "secondary")" @onclick="() => Delete(runner)" disabled="@busy">
                                @(pendingDelete == runner.Id ? "Confirm remove" : "Remove")
                            </button>
                        </span>
                    </div>
                    @if (editing == runner.Id)
                    {
                        <form class="form panel-body" @onsubmit="() => SaveEdit(runner)" @onsubmit:preventDefault>
                            <label for="edit-tags-@runner.Id">Tags of runner #@runner.Id</label>
                            <input id="edit-tags-@runner.Id" @bind="editTags" maxlength="1300" />
                            <label class="checkbox"><input type="checkbox" @bind="editRunUntagged" /> Also run jobs that list no tags</label>
                            <div class="form-actions">
                                <button type="submit" disabled="@busy">Save</button>
                                <button type="button" class="secondary" @onclick="() => editing = null" disabled="@busy">Cancel</button>
                            </div>
                        </form>
                    }
                }
            </div>
        }
    </div>

    <div class="panel">
        <div class="panel-header"><Icon Name="download" /><h2>Update a runner by hand</h2></div>
        <div class="panel-body">
            <p class="secondary-text">
                A runner older than the build this forge serves updates when you press Update above, once it has been
                updated by hand one time. The update script replaces its executable with the one this forge serves and
                restarts its service; it keeps the runner's registration and carries no secret. Run it on the runner's machine,
                as an administrator on Windows or as root on Linux. A job the runner is running at that moment is stopped.
            </p>
            <label for="update-ps1">Windows</label>
            <input id="update-ps1" readonly class="mono" value="@WindowsUpdateCommand" />
            <label for="update-sh">Linux</label>
            <input id="update-sh" readonly class="mono" value="@LinuxUpdateCommand" />
            <p class="field-hint">
                Add <span class="mono">-InstallDir</span> or <span class="mono">--dir</span> for a runner installed somewhere other than the
                install script's default, and <span class="mono">-Binary</span> or <span class="mono">--binary</span> to use a runner you already have.
            </p>
        </div>
    </div>
}

@code {
    private string Origin => Navigation.BaseUri.TrimEnd('/');
    private string WindowsUpdateCommand =>
        $"Invoke-WebRequest -UseBasicParsing {Origin}/-/runner/update.ps1 -OutFile update-graft-runner.ps1; powershell -ExecutionPolicy Bypass -File update-graft-runner.ps1";
    private string LinuxUpdateCommand => $"curl -fsSL {Origin}/-/runner/update.sh | sudo sh";

    private static string UpdateText(RunnerResponse runner) => runner.UpdateStatus switch
    {
        "current" => "runs the build this forge serves",
        "available" => "a different build is served here; it can be updated",
        "requested" => "update requested" + (runner.UpdateRequestedAt is DateTimeOffset at ? " at " + at.ToLocalTime().ToString("HH:mm") : "") +
            "; it updates the next time it is idle",
        "needs_script" => "too old to update itself: run the update script below on it once",
        "no_download" => "this forge serves no runner for its platform",
        _ => ""
    };

    private async Task RequestUpdate(RunnerResponse runner)
    {
        if (busy) return;
        busy = true;
        try
        {
            ApiResult<RunnerResponse> result = await Api.SendAsync(HttpMethod.Post, $"api/admin/runners/{runner.Id}/update", ApiJson.Default.RunnerResponse,
                $"Runner #{runner.Id} will update the next time it is idle, then restart as the new build.");
            message = result.Message;
            messageKind = result.Ok ? "success" : "error";
            await Load();
        }
        finally { busy = false; }
    }

    private async Task CancelUpdate(RunnerResponse runner)
    {
        if (busy) return;
        busy = true;
        try
        {
            ApiResult<RunnerResponse> result = await Api.SendAsync(HttpMethod.Delete, $"api/admin/runners/{runner.Id}/update", ApiJson.Default.RunnerResponse,
                $"Runner #{runner.Id} will not be asked to update.");
            message = result.Message;
            messageKind = result.Ok ? "success" : "error";
            await Load();
        }
        finally { busy = false; }
    }

    private async Task UpdateAll()
    {
        if (busy) return;
        busy = true;
        try
        {
            ApiResult<RunnerResponse[]> result = await Api.SendAsync(HttpMethod.Post, "api/admin/runners/update", ApiJson.Default.RunnerResponseArray,
                "Every runner that can update will do so the next time it is idle.");
            message = result.Ok && result.Value is { } asked ? $"{asked.Length} runner(s) will update the next time each is idle." : result.Message;
            messageKind = result.Ok ? "success" : "error";
            await Load();
        }
        finally { busy = false; }
    }
    private RunnerResponse[] runners = [];
    private RunnerCreatedResponse? created;
    private string description = "";
    private string copied = "";
    private bool failed;
    private long? pendingDelete;
    private string message = "";
    private string messageKind = "info";
    private bool loading = true;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!await Api.EnsureSessionAsync())
            {
                if (Api.Reachable) Navigation.NavigateTo("/-/login", replace: true);
                return;
            }
            if (Api.IsAdministrator) await Load();
        }
        finally { loading = false; }
    }

    private async Task Load() => runners = await Api.GetAsync("api/admin/runners", ApiJson.Default.RunnerResponseArray) ?? [];

    private async Task Create()
    {
        if (busy) return;
        busy = true;
        message = "";
        created = null;
        failed = false;
        copied = "";
        try
        {
            ApiResult<RunnerCreatedResponse> result = await Api.SendAsync(HttpMethod.Post, "api/admin/runners",
                new RunnerCreateRequest(description.Trim(), "instance_type", SplitTags(tags), runUntagged), ApiJson.Default.RunnerCreateRequest,
                ApiJson.Default.RunnerCreatedResponse, "Runner created. Copy its install script now; it is not shown again.");
            message = result.Message;
            messageKind = result.Ok ? "success" : "error";
            if (result.Ok) { created = result.Value; description = ""; tags = ""; runUntagged = true; await Load(); }
        }
        finally { busy = false; }
    }

    private string tags = "";
    private bool runUntagged = true;
    private long? editing;
    private string editTags = "";
    private bool editRunUntagged = true;

    private static string[] SplitTags(string text) => text.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private void StartEdit(RunnerResponse runner)
    {
        editing = editing == runner.Id ? null : runner.Id;
        editTags = string.Join(", ", runner.TagList ?? []);
        editRunUntagged = runner.RunUntagged;
    }

    private async Task SaveEdit(RunnerResponse runner)
    {
        if (busy) return;
        busy = true;
        try
        {
            ApiResult<RunnerResponse> result = await Api.SendAsync(HttpMethod.Put, $"api/admin/runners/{runner.Id}",
                new RunnerUpdateRequest(null, SplitTags(editTags), editRunUntagged), ApiJson.Default.RunnerUpdateRequest, ApiJson.Default.RunnerResponse,
                $"Runner #{runner.Id} saved. Jobs it takes from now on are matched against its new tags.");
            message = result.Message;
            messageKind = result.Ok ? "success" : "error";
            if (result.Ok) { editing = null; await Load(); }
        }
        finally { busy = false; }
    }

    private async Task Copy(string text, string which)
    {
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("graftClipboard.copy", text); }
        catch (JSException) { ok = false; }
        copied = ok ? which : "";
        failed = !ok;
    }

    private void Dismiss()
    {
        created = null;
        failed = false;
        copied = "";
        message = "";
    }

    private async Task Delete(RunnerResponse runner)
    {
        if (pendingDelete != runner.Id) { pendingDelete = runner.Id; return; }
        if (busy) return;
        busy = true;
        pendingDelete = null;
        try
        {
            ApiResult result = await Api.DeleteAsync($"api/admin/runners/{runner.Id}", $"Runner #{runner.Id} removed. Its credential no longer works.");
            message = result.Message;
            messageKind = result.Ok ? "success" : "error";
            await Load();
        }
        finally { busy = false; }
    }

    private static string StatusText(string status) => status switch
    {
        "online" => "Online",
        "offline" => "Offline",
        "never_contacted" => "Waiting for its script",
        "registration_expired" => "Script expired",
        _ => status
    };
}
