@page "/"
@page "/projects"
@inject GraftApi Api
@inject NavigationManager Navigation

<PageTitle>Projects &middot; Graft</PageTitle>

@if (loading)
{
    <p role="status" class="secondary-text">Loading…</p>
}
else if (!Api.Reachable)
{
    <div class="page-header"><div><h1>Graft is unavailable</h1><p class="subtitle">The server could not be reached.</p></div></div>
}
else
{
    <div class="page-header">
        <div><h1>Projects</h1></div>
        <div class="page-header-actions">
            <button type="button" class="@(creating ? "secondary" : "")" @onclick="() => creating = !creating">
                <Icon Name="plus" />New project
            </button>
        </div>
    </div>

    <Banner Message="@message" Kind="@messageKind" />

    @if (creating)
    {
        <div class="panel">
            <div class="panel-header"><h2>Create a private project</h2></div>
            <div class="panel-body">
                <form class="form" @onsubmit="CreateProject" @onsubmit:preventDefault>
                    @if (groups.Length > 0)
                    {
                        <label for="project-namespace">Namespace</label>
                        <select id="project-namespace" @bind="namespaceId">
                            <option value="">@Api.Username (your own)</option>
                            @foreach (GroupResponse group in groups.Where(group => group.AccessLevel >= 30)) { <option value="@group.Id">@group.FullPath</option> }
                        </select>
                    }
                    <label for="project-name">Name</label>
                    <input id="project-name" @bind="name" required="@(string.IsNullOrWhiteSpace(importUrl))" maxlength="200" />
                    <label for="project-path">Path</label>
                    <input id="project-path" @bind="path" minlength="2" maxlength="39"
                           pattern="[A-Za-z0-9](?:[A-Za-z0-9]|[._\-][A-Za-z0-9])+" />
                    <p class="field-hint">Optional. Derived from the name when left empty.</p>
                    <label for="project-description">Description</label>
                    <input id="project-description" @bind="description" maxlength="2000" />
                    <label for="project-import">Import from an address</label>
                    <input id="project-import" type="url" @bind="importUrl" @bind:event="oninput" maxlength="2048"
                           placeholder="https://example.com/owner/repository.git" />
                    <p class="field-hint">
                        Optional. A repository anybody may clone, over http or https. The project starts empty and fills
                        in while the import runs; the name and path come from the address when left empty.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(importUrl))
                    {
                        <label class="checkbox"><input type="checkbox" @bind="keepUpdated" /> Keep it up to date</label>
                        <p class="field-hint">
                            Checked for changes regularly. Nothing is ever removed here: a branch the original deletes is
                            kept, and one it rewrites keeps its old history under a preserved reference.
                        </p>
                    }
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Creating…" : "Create project")</button>
                        <button type="button" class="secondary" @onclick="() => creating = false" disabled="@busy">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="panel">
        <div class="panel-header"><h2>Your projects</h2><span class="spacer"></span><span class="label">@projects.Length</span></div>
        @if (projects.Length == 0)
        {
            <p class="panel-empty">No accessible projects yet.</p>
        }
        else
        {
            <div class="list">
                @foreach (ProjectResponse project in projects)
                {
                    <a class="list-item" href="/@project.PathWithNamespace">
                        <Avatar Url="@project.AvatarUrl" Name="@project.Name" Class="avatar-project" />
                        <span class="list-item-main">
                            <strong>@project.NameWithNamespace</strong>
                            <small>@(project.Description.Length > 0 ? project.Description : "No description")</small>
                        </span>
                        <VisibilityLabel Visibility="@project.Visibility" />
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    private ProjectResponse[] projects = [];
    private string name = "";
    private string path = "";
    private string description = "";
    private string importUrl = "";
    private bool keepUpdated = true;
    private string message = "";
    private string messageKind = "info";
    private bool creating;
    private bool loading = true;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!await Api.EnsureSessionAsync())
            {
                // An anonymous visitor goes to the public listing rather than to a sign-in form. If nothing
                // is published, or the operator has not enabled publishing, that page says so and offers
                // sign-in; sending a reader straight to a password prompt would hide a forge that is
                // deliberately open.
                if (Api.Reachable) Navigation.NavigateTo("/-/explore", replace: true);
                return;
            }
            await LoadProjects();
            await LoadGroups();
        }
        finally { loading = false; }
    }

    private async Task LoadProjects() =>
        projects = await Api.GetAsync("api/projects", ApiJson.Default.ProjectResponseArray) ?? [];

    private GroupResponse[] groups = [];
    private string namespaceId = "";

    private async Task LoadGroups() => groups = await Api.GetAsync("api/groups", ApiJson.Default.GroupResponseArray) ?? [];

    private async Task CreateProject()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            bool importing = !string.IsNullOrWhiteSpace(importUrl);
            ProjectCreateRequest request = new(string.IsNullOrWhiteSpace(name) ? null : name, string.IsNullOrWhiteSpace(path) ? null : path, description, "private",
                long.TryParse(namespaceId, out long inGroup) ? inGroup : null,
                importing ? importUrl.Trim() : null, importing ? keepUpdated : null);
            ApiResult result = await Api.PostAsync("api/projects", request, ApiJson.Default.ProjectCreateRequest,
                importing ? "Project created. The import is running; open the project to follow it." : "Project created.");
            message = result.Message;
            messageKind = result.Ok ? "success" : "error";
            if (!result.Ok) return;
            name = ""; path = ""; description = ""; importUrl = ""; keepUpdated = true; creating = false;
            await LoadProjects();
        }
        finally { busy = false; }
    }

    private static string Initial(string value) => value.Length == 0 ? "?" : value[..1];
}
