    private bool IsCommentingAt(string path, int? line, string side) =>
        line is not null && commentingPath == path && commentingLine == line && commentingSide == side;

    /// <summary>
    /// What this proposal's state actually means for somebody deciding whether to merge it. Graft's answer
    /// is narrower than other forges', so it is spelled out rather than left as a status word.
    /// </summary>
    private string MergeExplanation => proposal!.MergeMethod switch
    {
        "already_merged" when proposal.State == "merged" =>
            $"Merged into {proposal.TargetBranch} as {Short(proposal.MergeCommitSha)}.",
        "already_merged" => $"{proposal.TargetBranch} already contains this work. There is nothing to merge.",
        "fast_forward" =>
            $"{proposal.TargetBranch} has gained nothing since this branch left it, so merging moves it forward with no merge commit.",
        "three_way" =>
            "Both branches have moved, and no file was changed on both sides. Merging writes a merge commit that takes each side's changes.",
        "conflict" =>
            "Both branches changed the same file. Graft does not merge file contents, so this has to be merged locally and pushed. The files are below.",
        _ => "A branch this proposal names no longer exists, so there is nothing to compare."
    };

    private string MergeBannerKind => proposal!.MergeMethod switch
    {
        "conflict" => "warning",
        "fast_forward" or "three_way" => "success",
        _ => "info"
    };

    private static string Short(string? sha) => sha is null || sha.Length < 8 ? sha ?? "" : sha[..8];

    private static string StateClass(string state) => state switch
    {
        "merged" => "accent",
        "opened" => "success",
        _ => ""
    };

    private static string StatusClass(string status) => status switch
    {
        "added" => "accent",
        "deleted" => "danger",
        _ => ""
    };

    private static string LineClass(string kind) => kind switch
    {
        "+" => "diff-line diff-line-added",
        "-" => "diff-line diff-line-removed",
        _ => "diff-line"
    };

    /// <summary>
    /// A fragment id for a file, so the summary at the top links to the file below it. Built from the path
    /// with everything but letters, numbers and hyphens replaced, because a repository path may contain
    /// characters a fragment may not.
    /// </summary>
    private static string Anchor(string path) =>
        "file-" + new string([.. path.Select(character =>
            char.IsAsciiLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')]);

    private static string Initial(string name) => name.Length == 0 ? "?" : name[..1].ToUpperInvariant();

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        message = "";
        try
        {
            await Api.EnsureSessionAsync();
            if (!await ResolveProject()) return;
            allLabels = await Api.GetAsync($"api/projects/{projectId}/labels", ApiJson.Default.LabelResponseArray) ?? [];
            milestones = await Api.GetAsync($"api/projects/{projectId}/milestones?state=all", ApiJson.Default.MilestoneResponseArray) ?? [];
            people = canParticipate ? await Api.GetAsync($"api/projects/{projectId}/users", ApiJson.Default.UserResponseArray) ?? [] : [];
            if (Number is null) await LoadList();
            else await LoadOne();
        }
        finally { loading = false; }
    }

    private async Task SaveMeta(IssueUpdateRequest request)
    {
        if (busy || proposal is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{projectId}/merge-requests/{proposal.Iid}", request,
                ApiJson.Default.IssueUpdateRequest, "Details saved.");
            Report(result.Ok, result.Message);
            if (result.Ok) await LoadOne();
        }
        finally { busy = false; }
    }

    private Task SetDraft(bool draft) => SaveMeta(new IssueUpdateRequest(null, null, null, Draft: draft));

    private async Task<bool> ResolveProject()
    {
        string path = ViaSlug
            ? $"api/graft/slugs/{Uri.EscapeDataString(Slug)}"
            : $"api/browser/projects/{Uri.EscapeDataString(Namespace)}/{Uri.EscapeDataString(Slug)}";
        (bool reached, RepositoryPageResponse? page) = await Api.GetOptionalAsync(path, ApiJson.Default.RepositoryPageResponse);
        if (!reached) { message = "Graft could not be reached."; return false; }
        if (page is null) { message = "That repository could not be found."; return false; }
        project = page.Project;
        projectId = page.Project.Id;
        canParticipate = page.CanParticipate;
        canManage = page.CanManage;
        canPush = page.CanPush;
        branches = [.. page.Branches.Select(branch => branch.Name)];
        return true;
    }

    private void StartComposing()
    {
        composing = !composing;
        if (!composing) return;
        // The default branch as the target and anything else as the source, which is the proposal somebody
        // is nearly always about to make.
        draftTarget = project?.DefaultBranch is { Length: > 0 } preferred && branches.Contains(preferred)
            ? preferred
            : branches.FirstOrDefault() ?? "";
        draftSource = branches.FirstOrDefault(branch => branch != draftTarget) ?? "";
    }

    private async Task Filter(string next)
    {
        state = next;
        await LoadList();
    }

    private async Task LoadList()
    {
        string query = $"api/projects/{projectId}/merge-requests?state={state}&per_page=100";
        if (filterLabel.Length > 0) query += "&labels=" + Uri.EscapeDataString(filterLabel);
        if (filterMilestone.Length > 0) query += "&milestone_id=" + Uri.EscapeDataString(filterMilestone);
        if (filterReviewer.Length > 0) query += "&reviewer_username=" + Uri.EscapeDataString(filterReviewer);
        if (filterSearch.Trim().Length > 0) query += "&search=" + Uri.EscapeDataString(filterSearch.Trim());
        MergeRequestPageResponse? page = await Api.GetAsync(query, ApiJson.Default.MergeRequestPageResponse);
        proposals = page is null ? [] : [.. page.MergeRequests];
        total = page?.Total ?? 0;
    }

    private async Task LoadOne()
    {
        MergeRequestChangesResponse? changes = await Api.GetAsync(
            $"api/projects/{projectId}/merge-requests/{Number}/changes", ApiJson.Default.MergeRequestChangesResponse);
        if (changes is null)
        {
            proposal = null;
            message = "That merge request could not be found.";
            return;
        }
        proposal = changes.MergeRequest;
        files = [.. changes.Files];
        truncated = changes.Truncated;
        comments = await Api.GetAsync($"api/projects/{projectId}/merge-requests/{Number}/comments",
            ApiJson.Default.NoteResponseArray) ?? [];
    }

    private async Task Create()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            ApiResult<MergeRequestResponse> result = await Api.SendAsync<MergeRequestCreateRequest, MergeRequestResponse>(
                HttpMethod.Post, $"api/projects/{projectId}/merge-requests",
                new MergeRequestCreateRequest(draftSource, draftTarget, draftTitle, draftBody,
                    null, null, null, draftReviewers.Count == 0 ? null : [.. draftReviewers], draftDraft ? true : null),
                ApiJson.Default.MergeRequestCreateRequest, ApiJson.Default.MergeRequestResponse, "Merge proposed.");
            if (!result.Ok || result.Value is null) { Report(result.Ok, result.Message); return; }
            draftTitle = "";
            draftBody = "";
            draftDraft = false;
            draftReviewers.Clear();
            composing = false;
            Navigation.NavigateTo(MergeRequestUrl(result.Value.Iid));
        }
        finally { busy = false; }
    }

