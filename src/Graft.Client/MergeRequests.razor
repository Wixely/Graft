@page "/{Namespace}/{Slug}/-/merge-requests"
@page "/{Namespace}/{Slug}/-/merge-requests/{Number:long}"
@* The same pages under the project's instance-wide slug, for a link shared without an account name. *@
@page "/projects/{Slug}/-/merge-requests"
@page "/projects/{Slug}/-/merge-requests/{Number:long}"
@inject GraftApi Api
@inject NavigationManager Navigation

<PageTitle>@(Number is null ? "Merge requests" : "Merge request !" + Number) &middot; Graft</PageTitle>

@if (loading)
{
    <p role="status" class="secondary-text">Loading…</p>
}
else if (project is null)
{
    <div class="page-header"><div><h1>Unavailable</h1><p class="subtitle">@message</p></div></div>
    <a class="button secondary" href="/"><Icon Name="chevron-left" />Back to projects</a>
}
else if (Number is null)
{
    <div class="page-header">
        <div>
            <h1>Merge requests</h1>
            <p class="subtitle"><a href="@ProjectUrl">@project.Namespace.Name / @project.Name</a></p>
        </div>
        <div class="page-header-actions">
            <a class="button secondary" href="@IssuesUrl"><Icon Name="issue" />Issues</a>
            @if (canParticipate && branches.Length > 1)
            {
                <button type="button" class="@(composing ? "secondary" : "")" @onclick="StartComposing">
                    <Icon Name="plus" />New merge request
                </button>
            }
        </div>
    </div>

    <Banner Message="@message" Kind="@messageKind" />

    @if (canParticipate && branches.Length < 2)
    {
        <div class="banner info">
            <Icon Name="branch" />
            <span>A merge request needs two branches. This repository has @(branches.Length == 1 ? "one" : "none").</span>
        </div>
    }

    @if (composing)
    {
        <div class="panel">
            <div class="panel-header"><h2>Propose a merge</h2></div>
            <div class="panel-body">
                <form class="form" @onsubmit="Create" @onsubmit:preventDefault>
                    <label for="mr-source">From branch</label>
                    <select id="mr-source" @bind="draftSource">
                        @foreach (string branch in branches) { <option value="@branch">@branch</option> }
                    </select>
                    <label for="mr-target">Into branch</label>
                    <select id="mr-target" @bind="draftTarget">
                        @foreach (string branch in branches) { <option value="@branch">@branch</option> }
                    </select>
                    <label for="mr-title">Title</label>
                    <input id="mr-title" @bind="draftTitle" required maxlength="255" autocomplete="off" />
                    <label for="mr-body">Description</label>
                    <textarea id="mr-body" @bind="draftBody" rows="5" maxlength="50000"></textarea>
                    @if (people.Length > 0)
                    {
                        <fieldset class="checkbox-group">
                            <legend>Ask to review</legend>
                            @foreach (UserResponse person in people.Where(person => person.Username != Api.Username))
                            {
                                <label class="checkbox">
                                    <input type="checkbox" checked="@draftReviewers.Contains(person.Username)" @onchange="e => { if (e.Value is true) draftReviewers.Add(person.Username); else draftReviewers.Remove(person.Username); }" />
                                    @person.Username
                                </label>
                            }
                        </fieldset>
                    }
                    <label class="checkbox"><input type="checkbox" @bind="draftDraft" /> Draft: not ready to merge yet</label>
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Proposing…" : "Propose merge")</button>
                        <button type="button" class="secondary" @onclick="() => composing = false" disabled="@busy">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="tabs">
        <button type="button" class="@(state == "opened" ? "active" : "")" @onclick='() => Filter("opened")'>Open</button>
        <button type="button" class="@(state == "merged" ? "active" : "")" @onclick='() => Filter("merged")'>Merged</button>
        <button type="button" class="@(state == "closed" ? "active" : "")" @onclick='() => Filter("closed")'>Closed</button>
        <button type="button" class="@(state == "all" ? "active" : "")" @onclick='() => Filter("all")'>All</button>
    </div>

    <div class="list-filters">
        <input type="search" placeholder="Search titles and descriptions" aria-label="Search merge requests" @bind="filterSearch" @bind:after="LoadList" />
        <select aria-label="Label" @bind="filterLabel" @bind:after="LoadList">
            <option value="">Any label</option>
            @foreach (LabelResponse label in allLabels) { <option value="@label.Name">@label.Name</option> }
        </select>
        <select aria-label="Milestone" @bind="filterMilestone" @bind:after="LoadList">
            <option value="">Any milestone</option>
            <option value="None">No milestone</option>
            @foreach (MilestoneResponse milestone in milestones) { <option value="@milestone.Id">@milestone.Title</option> }
        </select>
        @if (canParticipate)
        {
            <select aria-label="Reviewer" @bind="filterReviewer" @bind:after="LoadList">
                <option value="">Any reviewer</option>
                <option value="None">No reviewer</option>
                @foreach (UserResponse person in people) { <option value="@person.Username">@person.Username</option> }
            </select>
        }
    </div>

    <div class="panel">
        <div class="panel-header">
            <Icon Name="merge" /><h2>Proposals</h2>
            <span class="spacer"></span>
            <span class="label">@total</span>
        </div>
        @if (proposals.Length == 0)
        {
            <div class="panel-empty">Nothing here.</div>
        }
        else
        {
            <div class="list">
                @foreach (MergeRequestResponse proposal in proposals)
                {
                    <div class="list-item">
                        <Icon Name="merge" Class="@(proposal.State == "opened" ? "icon" : "icon muted")" />
                        <span class="list-item-main">
                            <strong><a href="@MergeRequestUrl(proposal.Iid)">@proposal.Title</a></strong>
                            <small>
                                !@proposal.Iid &middot; <code>@proposal.SourceBranch</code> into
                                <code>@proposal.TargetBranch</code> &middot; by @proposal.Author.Username
                                @if (proposal.Reviewers is { Count: > 0 }) { <span> &middot; review: @string.Join(", ", proposal.Reviewers.Select(person => person.Username))</span> }
                                @if (proposal.Milestone is not null) { <span> &middot; @proposal.Milestone.Title</span> }
                            </small>
                            @if (proposal.LabelDetails is { Count: > 0 } || proposal.Draft)
                            {
                                <span class="list-labels">
                                    @if (proposal.Draft) { <span class="label">draft</span> }
                                    @foreach (LabelResponse label in proposal.LabelDetails ?? []) { <LabelChip Label="label" /> }
                                </span>
                            }
                        </span>
                        <span class="label @StateClass(proposal.State)">@proposal.State</span>
                    </div>
                }
            </div>
        }
    </div>
}
else if (proposal is null)
{
    <div class="page-header"><div><h1>Merge request unavailable</h1><p class="subtitle">@message</p></div></div>
    <a class="button secondary" href="@MergeRequestsUrl"><Icon Name="chevron-left" />Back</a>
}
else
{
    <div class="page-header">
        <div>
            <h1>@proposal.Title</h1>
            <p class="subtitle">
                !@proposal.Iid in <a href="@ProjectUrl">@project.Namespace.Name / @project.Name</a> &middot;
                <code>@proposal.SourceBranch</code> into <code>@proposal.TargetBranch</code> &middot;
                by @proposal.Author.Username
            </p>
        </div>
        <span class="label @StateClass(proposal.State)">@proposal.State</span>
        <div class="page-header-actions">
            <a class="button secondary" href="@MergeRequestsUrl"><Icon Name="chevron-left" />Merge requests</a>
        </div>
    </div>

    <Banner Message="@message" Kind="@messageKind" />

    <div class="work-layout">
    <div class="work-main">
    <div class="panel">
        <div class="panel-header"><Icon Name="merge" /><h2>Mergeability</h2></div>
        <div class="panel-body">
            <div class="banner @MergeBannerKind">
                <Icon Name="@(proposal.MergeMethod == "conflict" ? "alert" : "check")" />
                <span>@MergeExplanation</span>
            </div>
            @if (proposal.Draft && proposal.State == "opened")
            {
                <div class="banner info">
                    <Icon Name="alert" />
                    <span>Marked as a draft, so it will not merge until @(IsAuthor ? "you mark" : "the author marks") it ready.</span>
                </div>
            }
            @if (proposal.Conflicts is { Count: > 0 })
            {
                <ul class="plain">
                    @foreach (string path in proposal.Conflicts) { <li><code>@path</code></li> }
                </ul>
            }
            @if (proposal.ApprovalsRequired > 0 || proposal.ApprovedBy is { Count: > 0 })
            {
                <div class="banner @(proposal.ApprovalsLeft > 0 ? "warning" : "success")">
                    <Icon Name="@(proposal.ApprovalsLeft > 0 ? "alert" : "check")" />
                    <span>@ApprovalExplanation</span>
                </div>
            }
            @if (proposal.ApprovedBy is { Count: > 0 })
            {
                <div class="list">
                    @foreach (ApprovalResponse approval in proposal.ApprovedBy)
                    {
                        <div class="list-item">
                            <span class="avatar avatar-small" aria-hidden="true">@Initial(approval.Username)</span>
                            <span class="list-item-main">
                                <strong>@approval.Username</strong>
                                <small>
                                    approved @approval.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    at <code>@Short(approval.SourceCommitSha)</code>
                                </small>
                            </span>
                            <span class="label @(approval.Current ? "success" : "")">
                                @(approval.Current ? "current" : "superseded")
                            </span>
                        </div>
                    }
                </div>
            }
            <div class="form-actions">
                @if (canPush && proposal.State == "opened" && proposal.MergeStatus == "can_be_merged" && proposal.ApprovalsLeft == 0 && !proposal.Draft)
                {
                    <button type="button" @onclick="Merge" disabled="@busy">
                        @(busy ? "Merging…" : proposal.MergeMethod == "fast_forward" ? "Fast-forward" : "Merge")
                    </button>
                }
                @if (proposal.State == "opened" && proposal.Draft && CanChangeState)
                {
                    <button type="button" @onclick="() => SetDraft(false)" disabled="@busy">Mark as ready</button>
                }
                @if (canPush && proposal.State == "opened" && !IsAuthor)
                {
                    <button type="button" class="secondary" @onclick="() => SetApproval(!HasApproved)" disabled="@busy">
                        @(HasApproved ? "Withdraw approval" : "Approve")
                    </button>
                }
                @if (canPush && proposal.State == "merged" && branches.Contains(proposal.SourceBranch) &&
                     proposal.SourceBranch != project.DefaultBranch)
                {
                    <button type="button" class="secondary" @onclick="RemoveSourceBranch" disabled="@busy">
                        Delete <code>@proposal.SourceBranch</code>
                    </button>
                }
            </div>
            @if (canPush && proposal.State == "opened" && proposal.MergeStatus == "can_be_merged" && proposal.ApprovalsLeft == 0 && !proposal.Draft)
            {
                <label class="checkbox">
                    <input type="checkbox" @bind="removeSourceOnMerge" />
                    Delete <code>@proposal.SourceBranch</code> after merging
                </label>
            }
            @if (canPush && proposal.State == "opened" && IsAuthor && proposal.ApprovalsRequired > 0)
            {
                <p class="field-hint">You cannot approve your own proposal.</p>
            }
        </div>
    </div>

    @if (proposal.Description.Length > 0)
    {
        <div class="panel"><div class="panel-body"><pre class="commit-message">@proposal.Description</pre></div></div>
    }

    <div class="panel">
        <div class="panel-header">
            <Icon Name="file" /><h2>Changes</h2>
            <span class="spacer"></span>
            <span class="label">@files.Length @(files.Length == 1 ? "file" : "files")</span>
            @if (files.Length > 0)
            {
                <span class="diff-total">
                    <span class="diff-added">+@files.Sum(file => file.Added)</span>
                    <span class="diff-removed">&minus;@files.Sum(file => file.Removed)</span>
                </span>
            }
        </div>
        @if (files.Length == 0)
        {
            <div class="panel-empty">Nothing differs from where the branches last agreed.</div>
        }
        else
        {
            <div class="list">
                @foreach (DiffFileResponse file in files)
                {
                    <div class="list-item">
                        <span class="list-item-main"><strong><a href="#@Anchor(file.Path)"><code>@file.Path</code></a></strong></span>
                        <span class="label @StatusClass(file.Status)">@file.Status</span>
                        <span class="list-item-meta"><small>+@file.Added &minus;@file.Removed</small></span>
                    </div>
                }
            </div>
        }
        @if (truncated)
        {
            <div class="panel-footer">
                <span class="secondary-text">
                    This comparison was cut short, so files are missing from it. Compare locally to see the whole change.
                </span>
            </div>
        }
    </div>

    @* The change itself, file by file, the same rendering the commit page uses. Every cell binds repository
       content as text, so it is escaped by the renderer and never interpreted as markup. *@
    @foreach (DiffFileResponse file in files)
    {
        <div class="panel diff-file" id="@Anchor(file.Path)">
            <div class="panel-header">
                <Icon Name="file" />
                <strong class="mono">@file.Path</strong>
                <span class="label @StatusClass(file.Status)">@file.Status</span>
                @if (!file.IsBinary && !file.TooLarge)
                {
                    <span class="diff-total">
                        <span class="diff-added">+@file.Added</span>
                        <span class="diff-removed">&minus;@file.Removed</span>
                    </span>
                }
            </div>

            @if (file.IsBinary)
            {
                <p class="panel-empty">Binary file; no line comparison is shown.</p>
            }
            else if (file.TooLarge)
            {
                <p class="panel-empty">This file is too large to compare line by line.</p>
            }
            else if (file.Hunks.Count == 0)
            {
                <p class="panel-empty">
                    @if (file.OldMode is not null && file.NewMode is not null && file.OldMode != file.NewMode)
                    {
                        @($"Mode changed from {file.OldMode} to {file.NewMode}; the content is unchanged.")
                    }
                    else
                    {
                        @("No content changes.")
                    }
                </p>
            }
            else
            {
                <table class="diff">
                    <tbody>
                        @foreach (DiffHunkResponse hunk in file.Hunks)
                        {
                            <tr class="diff-hunk">
                                <td class="diff-number" colspan="3"></td>
                                <td class="diff-text">@hunk.Header</td>
                            </tr>
                            @foreach (DiffLineResponse line in hunk.Lines)
                            {
                                string side = line.Kind == "-" ? "old" : "new";
                                int? number = line.Kind == "-" ? line.OldLine : line.NewLine;
                                <tr class="@LineClass(line.Kind)">
                                    <td class="diff-gutter">
                                        @if (canParticipate && number is not null)
                                        {
                                            <button type="button" class="line-comment"
                                                    title="Comment on this line"
                                                    @onclick="() => StartLineComment(file.Path, number.Value, side)">+</button>
                                        }
                                    </td>
                                    <td class="diff-number">@(line.OldLine?.ToString() ?? "")</td>
                                    <td class="diff-number">@(line.NewLine?.ToString() ?? "")</td>
                                    <td class="diff-text"><span class="diff-sign">@line.Kind</span>@line.Text</td>
                                </tr>
                                @if (line.NoNewline)
                                {
                                    <tr class="diff-note">
                                        <td class="diff-number" colspan="3"></td>
                                        <td class="diff-text">\ No newline at end of file</td>
                                    </tr>
                                }
                                @foreach (NoteResponse note in AnchoredAt(file.Path, number, side))
                                {
                                    <tr class="diff-comment">
                                        <td colspan="4">
                                            <CommentThread Root="note" Replies="RepliesTo(note.Id)" CanParticipate="canParticipate"
                                                           CanPush="canPush" CanManage="canManage" Username="@Api.Username" Busy="busy"
                                                           OnReply="Reply" OnEdit="EditComment" OnDelete="DeleteComment" OnResolve="ResolveThread" />
                                        </td>
                                    </tr>
                                }
                                @if (IsCommentingAt(file.Path, number, side))
                                {
                                    <tr class="diff-comment">
                                        <td colspan="4">
                                            <form class="form" @onsubmit="AddLineComment" @onsubmit:preventDefault>
                                                <label for="line-comment">Comment on line @number</label>
                                                <textarea id="line-comment" @bind="lineCommentBody" rows="3" maxlength="50000" required></textarea>
                                                <div class="form-actions">
                                                    <button type="submit" disabled="@busy">@(busy ? "Posting…" : "Comment")</button>
                                                    <button type="button" class="secondary" @onclick="CancelLineComment" disabled="@busy">Cancel</button>
                                                </div>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            }

            @* Comments written against an earlier version of this file. They are kept and shown, because
               somebody said them, but not placed on a line: the line they named may now be a different
               line. *@
            @{ NoteResponse[] stale = OutdatedFor(file.Path); }
            @if (stale.Length > 0)
            {
                <div class="panel-body">
                    <div class="banner info">
                        <Icon Name="alert" />
                        <span>
                            @stale.Length @(stale.Length == 1 ? "comment was" : "comments were") written against an
                            earlier version of this file, so @(stale.Length == 1 ? "it is" : "they are") shown here
                            rather than on a line.
                        </span>
                    </div>
                    <div class="list">
                        @foreach (NoteResponse note in stale)
                        {
                            <CommentThread Root="note" Replies="RepliesTo(note.Id)" CanParticipate="canParticipate"
                                           CanPush="canPush" CanManage="canManage" Username="@Api.Username" Busy="busy"
                                           Caption="StaleCaption"
                                           OnReply="Reply" OnEdit="EditComment" OnDelete="DeleteComment" OnResolve="ResolveThread" />
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div class="panel">
        <div class="panel-header">
            <h2>Comments</h2>
            <span class="spacer"></span>
            <span class="label">@comments.Length</span>
        </div>
        @if (GeneralComments.Length == 0)
        {
            <div class="panel-empty">
                @(comments.Length == 0 ? "Nothing said yet." : "Everything said so far is on a line of the diff above.")
            </div>
        }
        else
        {
            <div class="list">
                @foreach (NoteResponse note in GeneralComments)
                {
                    <CommentThread Root="note" Replies="RepliesTo(note.Id)" CanParticipate="canParticipate"
                                   CanPush="canPush" CanManage="canManage" Username="@Api.Username" Busy="busy"
                                   OnReply="Reply" OnEdit="EditComment" OnDelete="DeleteComment" OnResolve="ResolveThread" />
                }
            </div>
        }
        @if (canParticipate)
        {
            <div class="panel-body">
                <form class="form" @onsubmit="AddComment" @onsubmit:preventDefault>
                    <label for="mr-comment">Add a comment</label>
                    <textarea id="mr-comment" @bind="commentBody" rows="4" maxlength="50000" required></textarea>
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Posting…" : "Comment")</button>
                        @if (CanChangeState)
                        {
                            <button type="button" class="secondary" @onclick="ToggleState" disabled="@busy">
                                @(proposal.State == "closed" ? "Reopen" : "Close")
                            </button>
                        }
                    </div>
                </form>
            </div>
        }
    </div>
    </div>
    <WorkMeta ProjectUrl="@ProjectUrl" AllLabels="allLabels" Milestones="milestones" People="people"
              SelectedLabels="@([.. proposal.LabelDetails ?? []])" Milestone="proposal.Milestone"
              Assignees="@(proposal.Assignees ?? [])" Reviewers="@(proposal.Reviewers ?? [])"
              Draft="proposal.Draft" ShowDraft="@(proposal.State == "opened")" TimeStats="proposal.TimeStats"
              CanTriage="@(canParticipate && proposal.State != "merged" && (canPush || IsAuthor))" CanEditFlags="@CanChangeState" Busy="busy" OnSave="SaveMeta" />
    </div>
}

@code {
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public long? Number { get; set; }

    private ProjectResponse? project;
    private long projectId;
    private bool canParticipate;
    private bool canManage;
    private bool canPush;
    private string[] branches = [];
    private MergeRequestResponse[] proposals = [];
    private MergeRequestResponse? proposal;
    private DiffFileResponse[] files = [];
    private NoteResponse[] comments = [];
    private long total;
    private bool truncated;
    private bool removeSourceOnMerge;
    private string? commentingPath;
    private int? commentingLine;
    private string? commentingSide;
    private string lineCommentBody = "";
    private string state = "opened";
    private string draftSource = "";
    private string draftTarget = "";
    private string draftTitle = "";
    private string draftBody = "";
    private bool draftDraft;
    private readonly HashSet<string> draftReviewers = new(StringComparer.OrdinalIgnoreCase);
    private LabelResponse[] allLabels = [];
    private MilestoneResponse[] milestones = [];
    private UserResponse[] people = [];
    private string filterSearch = "";
    private string filterLabel = "";
    private string filterMilestone = "";
    private string filterReviewer = "";
    private string commentBody = "";
    private string message = "";
    private string messageKind = "info";
    private bool composing;
    private bool loading = true;
    private bool busy;

    private bool ViaSlug => Namespace.Length == 0;
    private string ProjectUrl => ViaSlug
        ? $"/projects/{Uri.EscapeDataString(Slug)}"
        : $"/{Uri.EscapeDataString(Namespace)}/{Uri.EscapeDataString(Slug)}";
    private string IssuesUrl => ProjectUrl + "/-/issues";
    private string MergeRequestsUrl => ProjectUrl + "/-/merge-requests";
    private string MergeRequestUrl(long number) => $"{MergeRequestsUrl}/{number}";

    private bool CanChangeState => proposal is not null && canParticipate && proposal.State != "merged" &&
        (canManage || string.Equals(proposal.Author.Username, Api.Username, StringComparison.Ordinal));

    private bool IsAuthor => proposal is not null &&
        string.Equals(proposal.Author.Username, Api.Username, StringComparison.Ordinal);

    private bool HasApproved => proposal?.ApprovedBy?.Any(approval =>
        string.Equals(approval.Username, Api.Username, StringComparison.Ordinal)) == true;

    /// <summary>
    /// What the approval gate means right now, in a sentence rather than a pair of numbers. The superseded
    /// case is the one worth spelling out: an approval that no longer counts is not an approval that was
    /// withdrawn, and the difference is not obvious from a count alone.
    /// </summary>
    private string ApprovalExplanation
    {
        get
        {
            int current = proposal!.ApprovedBy?.Count(approval => approval.Current) ?? 0;
            int superseded = (proposal.ApprovedBy?.Count ?? 0) - current;
            if (proposal.ApprovalsRequired == 0)
                return $"{current} {(current == 1 ? "person has" : "people have")} approved. This project requires none.";
            string stale = superseded == 0
                ? ""
                : $" {superseded} earlier {(superseded == 1 ? "approval was" : "approvals were")} superseded by a later push.";
            return proposal.ApprovalsLeft > 0
                ? $"{current} of {proposal.ApprovalsRequired} approvals of the current branch.{stale}"
                : $"Approved by {current} of the {proposal.ApprovalsRequired} required.{stale}";
        }
    }

    /// <summary>Threads that belong in the conversation rather than on a line. Replies sit under their
    /// first comment wherever that is, so only first comments are placed.</summary>
    private NoteResponse[] GeneralComments => [.. comments.Where(note => note.Path is null && note.ParentId is null)];

    /// <summary>Threads sitting on one line of one file, as that file looks now.</summary>
    private NoteResponse[] AnchoredAt(string path, int? line, string side) => line is null
        ? []
        : [.. comments.Where(note => !note.Outdated && note.Path == path && note.Line == line && note.Side == side)];

    /// <summary>Threads on this file written against a commit that is no longer the branch tip.</summary>
    private NoteResponse[] OutdatedFor(string path) =>
        [.. comments.Where(note => note.Outdated && note.Path == path)];

    private NoteResponse[] RepliesTo(long rootId) => [.. comments.Where(note => note.ParentId == rootId)];

    private string? StaleCaption(NoteResponse note) =>
        note.Path is null ? null : $"on line {note.Line} at {Short(note.AnchorCommitSha)}";

    private async Task Reply((long ParentId, string Body) reply)
    {
        if (busy || proposal is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{projectId}/merge-requests/{proposal.Iid}/comments",
                new NoteCreateRequest(reply.Body, ParentId: reply.ParentId), ApiJson.Default.NoteCreateRequest, "Reply added.");
            Report(result.Ok, result.Message);
            if (result.Ok) await LoadOne();
        }
