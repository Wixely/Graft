    private void StartLineComment(string path, int line, string side)
    {
        commentingPath = path;
        commentingLine = line;
        commentingSide = side;
        lineCommentBody = "";
    }

    private void CancelLineComment()
    {
        commentingPath = null;
        commentingLine = null;
        commentingSide = null;
        lineCommentBody = "";
    }

    private async Task AddLineComment()
    {
        if (busy || proposal is null || commentingPath is null || commentingLine is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{projectId}/merge-requests/{proposal.Iid}/comments",
                new NoteCreateRequest(lineCommentBody, commentingPath, commentingLine, commentingSide),
                ApiJson.Default.NoteCreateRequest, "Comment added.");
            Report(result.Ok, result.Message);
            if (!result.Ok) return;
            CancelLineComment();
            await LoadOne();
        }
        finally { busy = false; }
    }

    private void Report(bool ok, string text)
    {
        message = text;
        messageKind = ok ? "success" : "error";
    }
