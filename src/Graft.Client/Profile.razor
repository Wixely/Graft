@page "/-/profile"
@inject GraftApi Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Profile &middot; Graft</PageTitle>

@if (loading)
{
    <p role="status" class="secondary-text">Loading…</p>
}
else if (Api.Authenticated)
{
    <div class="page-header">
        <div class="row">
            <Avatar Url="@Api.Session?.AvatarUrl" Name="@Api.Username" Class="avatar-large" />
            <div>
                <h1>@Api.Username</h1>
                <p class="subtitle">@(Api.IsAdministrator ? "Administrator" : "User") on this instance.</p>
            </div>
        </div>
    </div>

    <Banner Message="@message" Kind="@messageKind" />

    <div class="tabs">
        <button type="button" class="@(tab == "tokens" ? "active" : "")" @onclick='() => tab = "tokens"'>Access tokens</button>
        <button type="button" class="@(tab == "keys" ? "active" : "")" @onclick='() => tab = "keys"'>SSH keys</button>
        <button type="button" class="@(tab == "email" ? "active" : "")" @onclick='() => tab = "email"'>Email</button>
        <button type="button" class="@(tab == "second-factor" ? "active" : "")" @onclick='() => tab = "second-factor"'>Two-factor</button>
        <button type="button" class="@(tab == "avatar" ? "active" : "")" @onclick='() => tab = "avatar"'>Avatar</button>
        <button type="button" class="@(tab == "password" ? "active" : "")" @onclick='() => tab = "password"'>Password</button>
    </div>

    @if (tab == "avatar")
    {
        <div class="panel">
            <div class="panel-header"><Icon Name="user" /><h2>Your avatar</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    PNG, JPEG, GIF or WebP, up to 2&nbsp;MB and 4096&nbsp;pixels on a side. SVG is not accepted.
                </p>
                <UploadField Profile="avatar" Id="user-avatar" OnCompleted="SetAvatar" />
            </div>
        </div>
    }

    @if (tab == "tokens")
    {
        @* The token's secret is never put on this page. It waits on the server for one read, and the button
           below fetches it straight into the clipboard. A token nobody copies therefore never reaches the
           browser, and a copied one is never in the document for a screenshot or an extension to find. *@
        @if (created is not null || fallbackSecret is not null)
        {
            <div class="secret" role="status">
                @if (fallbackSecret is null && collected)
                {
                    <strong>Copied. @created!.Name is ready to use.</strong>
                    <p class="field-hint">The secret is no longer available anywhere. Create another token if you lose it.</p>
                }
                else if (fallbackSecret is not null)
                {
                    @* Only when the clipboard refused. The alternative is the reader losing a token they
                       just made, which is worse than showing it once with a warning. *@
                    <strong>The clipboard refused the copy. Take this now, it will not be shown again.</strong>
                    <code>@fallbackSecret</code>
                    <div class="form-actions">
                        <button type="button" class="secondary" @onclick="() => { fallbackSecret = null; collected = true; }">I have it</button>
                    </div>
                }
                else
                {
                    <strong>@created!.Name @(rotated ? "has a new secret" : "is created"). Copy it now.</strong>
                    <p class="field-hint">
                        The secret is held for five minutes and can be read once. It is never shown on this
                        page, so copy it straight to the clipboard.
                    </p>
                    <div class="form-actions">
                        <button type="button" @onclick="CopyToken" disabled="@busy">
                            <Icon Name="copy" />Copy the token
                        </button>
                    </div>
                }
            </div>
        }

        @* Confirming the account password before an existing secret is produced. A session alone must not
           become every credential the account holds, so this is asked for every read. *@
        @if (secretFor is not null)
        {
            <div class="panel">
                <div class="panel-header"><Icon Name="key" /><h2>Copy @secretFor.Name</h2></div>
                <div class="panel-body">
                    <p class="secondary-text">
                        Confirm your password. The secret goes straight to the clipboard and is not shown here.
                    </p>
                    <form class="form" @onsubmit="CopyExisting" @onsubmit:preventDefault>
                        <label for="secret-password">Your password</label>
                        <input id="secret-password" type="password" @bind="secretPassword" required maxlength="256" autocomplete="current-password" />
                        <div class="form-actions">
                            <button type="submit" disabled="@busy">@(busy ? "Copying…" : "Copy to clipboard")</button>
                            <button type="button" class="secondary" @onclick="CancelSecret" disabled="@busy">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <div class="panel">
            <div class="panel-header"><h2>Create a personal access token</h2></div>
            <div class="panel-body">
                <form class="form" @onsubmit="CreateToken" @onsubmit:preventDefault>
                    <label for="token-name">Name</label>
                    <input id="token-name" @bind="tokenName" required maxlength="100" />
                    <label for="token-lifetime">Expires after</label>
                    <select id="token-lifetime" @bind="tokenLifetimeDays">
                        <option value="30">30 days</option>
                        <option value="90">90 days</option>
                        <option value="180">180 days</option>
                        <option value="365">365 days</option>
                    </select>
                    <fieldset>
                        <legend>Scopes</legend>
                        <label class="checkbox"><input type="checkbox" @bind="scopeReadApi" /> Read API</label>
                        <label class="checkbox"><input type="checkbox" @bind="scopeApi" /> API</label>
                        <label class="checkbox"><input type="checkbox" @bind="scopeReadRepository" /> Read repositories</label>
                        <label class="checkbox"><input type="checkbox" @bind="scopeWriteRepository" /> Write repositories</label>
                    </fieldset>
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Creating…" : "Create token")</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Active tokens</h2><span class="spacer"></span><span class="label">@tokens.Length</span></div>
            @if (tokens.Length == 0)
            {
                <p class="panel-empty">No active personal access tokens.</p>
            }
            else
            {
                <div class="list">
                    @foreach (TokenResponse token in tokens)
                    {
                        <div class="list-item">
                            <Icon Name="key" />
                            <span class="list-item-main">
                                <strong>@token.Name</strong>
                                <small>@string.Join(", ", token.Scopes) &middot; expires @token.ExpiresAtUtc.ToString("yyyy-MM-dd")</small>
                            </span>
                            <span class="list-item-actions">
                                @* Offered only where the secret was kept, which depends on what the
                                   operator had configured when this token was issued. A token without it
                                   cannot be read back by anyone, including an administrator. *@
                                @if (token.Recoverable)
                                {
                                    <button type="button" class="secondary" @onclick="() => AskForSecret(token)" disabled="@busy">
                                        <Icon Name="copy" />Copy
                                    </button>
                                }
                                @* Two clicks, because the old secret stops working the moment the new one
                                   exists: whatever uses this token breaks until the new secret reaches it. *@
                                <button type="button" class="@(pendingRotate == token.Id ? "danger" : "secondary")"
                                        @onclick="() => RotateToken(token)" disabled="@busy">
                                    @(pendingRotate == token.Id ? "Confirm rotate" : "Rotate")
                                </button>
                                <button type="button" class="secondary" @onclick="() => RevokeToken(token)" disabled="@busy">Revoke</button>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (tab == "keys")
    {
        <div class="panel">
            <div class="panel-header"><h2>Add an SSH key</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    Paste the public half of a key, the contents of a <span class="mono">.pub</span> file, as one line.
                    Graft accepts Ed25519, ECDSA and RSA keys. A key lets you clone and push over SSH as yourself;
                    it grants nothing a token could not, and nothing beyond Git.
                </p>
                <form class="form" @onsubmit="AddKey" @onsubmit:preventDefault>
                    <label for="key-title">Title</label>
                    <input id="key-title" @bind="keyTitle" required maxlength="100" placeholder="laptop" />
                    <label for="key-text">Public key</label>
                    <textarea id="key-text" @bind="keyText" required rows="3" spellcheck="false" placeholder="ssh-ed25519 AAAA… comment"></textarea>
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Adding…" : "Add key")</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Your SSH keys</h2><span class="spacer"></span><span class="label">@keys.Length</span></div>
            @if (keys.Length == 0)
            {
                <p class="panel-empty">No SSH keys. Cloning and pushing over SSH needs one.</p>
            }
            else
            {
                <div class="list">
                    @foreach (SshKeyResponse key in keys)
                    {
                        <div class="list-item">
                            <Icon Name="key" />
                            <span class="list-item-main">
                                <strong>@key.Title</strong>
                                <small class="mono">@key.Fingerprint</small>
                                <small>
                                    @key.Key.Split(' ')[0] &middot; added @key.CreatedAt.ToString("yyyy-MM-dd")
                                    @(key.LastUsedAt is DateTimeOffset used ? " · last used " + used.ToString("yyyy-MM-dd") : " · never used")
                                    @(key.ExpiresAt is DateTimeOffset expires ? " · expires " + expires.ToString("yyyy-MM-dd") : "")
                                </small>
                            </span>
                            <span class="list-item-actions">
                                @* Two clicks: a removed key stops every clone and push that used it, at once. *@
                                <button type="button" class="@(pendingKeyDelete == key.Id ? "danger" : "secondary")"
                                        @onclick="() => DeleteKey(key)" disabled="@busy">
                                    @(pendingKeyDelete == key.Id ? "Confirm remove" : "Remove")
                                </button>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (tab == "email")
    {
        <div class="panel">
            <div class="panel-header"><h2>Email address</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    @if (Api.Session?.MailAvailable == true)
                    {
                        <span>Used for one thing: a password reset link, if you ask for one. Nothing else is sent.</span>
                    }
                    else
                    {
                        <span>
                            This server does not send email, so the address is kept for the record and for a server
                            that does later. A forgotten password is reset with a link from an administrator.
                        </span>
                    }
                </p>
                <form class="form" @onsubmit="SaveEmail" @onsubmit:preventDefault>
                    <label for="email">Address</label>
                    <input id="email" type="email" autocomplete="email" @bind="email" maxlength="254" placeholder="you@example.com" />
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Saving…" : "Save")</button>
                        @if (!string.IsNullOrEmpty(Api.Session?.Email))
                        {
                            <button type="button" class="secondary" @onclick="ClearEmail" disabled="@busy">Remove</button>
                        }
                    </div>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Notifications by email</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    Your <a href="/-/notifications">inbox</a> always has everything that concerns you. This sends a message
                    for each entry as well, to the address above.
                    @if (Api.Session?.MailAvailable != true)
                    {
                        <span>This server does not send email, so the choice is kept for a server that does.</span>
                    }
                </p>
                <label class="checkbox">
                    <input type="checkbox" checked="@(Api.Session?.NotifyByEmail == true)" @onchange="ToggleNotifyByEmail" disabled="@busy" />
                    Email me each notification
                </label>
            </div>
        </div>
    }
    else if (tab == "second-factor")
    {
        @if (recoveryCodes is not null)
        {
            <div class="panel">
                <div class="panel-header"><Icon Name="shield" /><h2>Your recovery codes</h2></div>
                <div class="panel-body">
                    <div class="banner warning">
                        <Icon Name="alert" />
                        <span>Shown once. Keep them somewhere that is not the phone. Each signs you in one time if the app is gone.</span>
                    </div>
                    <pre class="commit-message">@string.Join("\n", recoveryCodes)</pre>
                    <div class="form-actions">
                        <button type="button" @onclick="() => recoveryCodes = null">I have kept them</button>
                    </div>
                </div>
            </div>
        }
        else if (Api.Session?.SecondFactorEnabled == true)
        {
            <div class="panel">
                <div class="panel-header"><Icon Name="shield" /><h2>Two-factor sign-in is on</h2></div>
                <div class="panel-body">
                    <p class="secondary-text">
                        Signing in asks for a code from your authenticator app after your password. Personal access
                        tokens and SSH keys are unaffected: they are issued from inside a session that already passed both.
                        Turning it off needs your password and a current code, so a stolen session cannot.
                    </p>
                    <form class="form" @onsubmit="DisableSecondFactor" @onsubmit:preventDefault>
                        <label for="disable-password">Password</label>
                        <input id="disable-password" type="password" autocomplete="current-password" @bind="factorPassword" required maxlength="256" />
                        <label for="disable-code">Code from the app, or a recovery code</label>
                        <input id="disable-code" autocomplete="one-time-code" inputmode="numeric" @bind="factorCode" required maxlength="32" />
                        <div class="form-actions">
                            <button type="submit" class="danger" disabled="@busy">Turn off</button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else if (setup is not null)
        {
            <div class="panel">
                <div class="panel-header"><Icon Name="shield" /><h2>Add this account to your authenticator app</h2></div>
                <div class="panel-body">
                    <p class="secondary-text">
                        Enter the key in the app, or paste the address into one that takes it. Then type the code the
                        app shows to confirm. Nothing is on until a code is accepted.
                    </p>
                    <label for="factor-secret">Key</label>
                    <div class="clone-row"><input id="factor-secret" readonly class="mono" value="@setup.Secret" /></div>
                    <label for="factor-uri">Address</label>
                    <div class="clone-row"><input id="factor-uri" readonly class="mono" value="@setup.OtpauthUri" /></div>
                    <form class="form" @onsubmit="ConfirmSecondFactor" @onsubmit:preventDefault>
                        <label for="confirm-code">Code from the app</label>
                        <input id="confirm-code" autocomplete="one-time-code" inputmode="numeric" @bind="factorCode" required minlength="6" maxlength="6" />
                        <div class="form-actions">
                            <button type="submit" disabled="@busy">Confirm and turn on</button>
                            <button type="button" class="secondary" @onclick="() => setup = null" disabled="@busy">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="panel">
                <div class="panel-header"><Icon Name="shield" /><h2>Two-factor sign-in</h2></div>
                <div class="panel-body">
                    <p class="secondary-text">
                        A code from an authenticator app after your password. It needs no email and no phone number;
                        any app that speaks the usual time-based codes works. You get recovery codes for the day the
                        app is gone, and an administrator can remove the factor if the codes are gone too.
                    </p>
                    <div class="form-actions">
                        <button type="button" @onclick="BeginSecondFactor" disabled="@busy">Set up</button>
                    </div>
                </div>
            </div>
        }
    }
    else if (tab == "password")
    {
        <div class="panel">
            <div class="panel-header"><h2>Change your password</h2></div>
            <div class="panel-body">
                <div class="banner warning">
                    <Icon Name="alert" />
                    <span>This signs you out everywhere and revokes your personal access tokens.</span>
                </div>
                <form class="form" @onsubmit="ChangePassword" @onsubmit:preventDefault>
                    <label for="current-password">Current password</label>
                    @* Existing credential, so no minlength: only the new-password fields state the policy. *@
                    <input id="current-password" type="password" @bind="currentPassword" required maxlength="256" autocomplete="current-password" />
                    <label for="new-password">New password</label>
                    <input id="new-password" type="password" @bind="newPassword" required minlength="16" maxlength="256" autocomplete="new-password" />
                    <label for="confirm-password">Confirm new password</label>
                    <input id="confirm-password" type="password" @bind="confirmPassword" required minlength="16" maxlength="256" autocomplete="new-password" />
                    <div class="form-actions">
                        <button type="submit" class="danger" disabled="@busy">Change password</button>
                    </div>
                </form>
            </div>
        </div>
    }
}

@code {
    private TokenResponse[] tokens = [];
    private TokenCreatedResponse? created;
    /// <summary>Set once the secret has reached the clipboard, so the panel stops offering it.</summary>
    private bool collected;
    /// <summary>Held only when the clipboard refused, which is the one case the secret has to be shown.</summary>
    private string? fallbackSecret;
    /// <summary>The token whose secret is being asked for, while the password is confirmed.</summary>
    private TokenResponse? secretFor;
    private string secretPassword = "";
    private string tab = "tokens";
    private string tokenName = "";
    private int tokenLifetimeDays = 30;
    private bool scopeReadApi;
    private bool scopeApi;
    private bool scopeReadRepository = true;
    private bool scopeWriteRepository;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string message = "";
    private string messageKind = "info";
    private bool loading = true;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!await Api.EnsureSessionAsync())
            {
                if (Api.Reachable) Navigation.NavigateTo("/-/login", replace: true);
                return;
            }
            await LoadTokens();
            await LoadKeys();
        }
        finally { loading = false; }
    }

    private async Task LoadTokens() => tokens = await Api.GetAsync("api/tokens", ApiJson.Default.TokenResponseArray) ?? [];

    private SecondFactorSetupResponse? setup;
    private string[]? recoveryCodes;
    private string factorPassword = "";
    private string factorCode = "";

    private async Task BeginSecondFactor()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            ApiResult<SecondFactorSetupResponse> result = await Api.SendAsync(HttpMethod.Post, "api/second-factor/begin",
                ApiJson.Default.SecondFactorSetupResponse, "");
            if (result.Ok) { setup = result.Value; factorCode = ""; }
            else Report(new ApiResult(false, result.Message));
        }
        finally { busy = false; }
    }

    private async Task ConfirmSecondFactor()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            ApiResult<RecoveryCodesResponse> result = await Api.SendAsync(HttpMethod.Post, "api/second-factor/confirm",
                new SecondFactorCodeRequest(factorCode.Trim()), ApiJson.Default.SecondFactorCodeRequest, ApiJson.Default.RecoveryCodesResponse,
                "Two-factor sign-in is on.");
            Report(new ApiResult(result.Ok, result.Message));
            if (result.Ok)
            {
                setup = null;
                factorCode = "";
                recoveryCodes = result.Value?.RecoveryCodes;
                await Api.RefreshSessionAsync();
            }
        }
        finally { busy = false; }
    }

    private async Task DisableSecondFactor()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            Report(await Api.PostAsync("api/second-factor/disable", new SecondFactorDisableRequest(factorPassword, factorCode.Trim()),
                ApiJson.Default.SecondFactorDisableRequest, "Two-factor sign-in is off."));
            factorPassword = "";
            factorCode = "";
            await Api.RefreshSessionAsync();
        }
        finally { busy = false; }
    }

    private string email = "";

    protected override void OnParametersSet() => email = Api.Session?.Email ?? email;

    private async Task SaveEmail()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            Report(await Api.PostAsync("api/email", new EmailChangeRequest(email.Trim()), ApiJson.Default.EmailChangeRequest,
                email.Trim().Length == 0 ? "Email address removed." : "Email address saved."));
            await Api.RefreshSessionAsync();
            email = Api.Session?.Email ?? "";
        }
        finally { busy = false; }
    }

    private async Task ToggleNotifyByEmail(ChangeEventArgs change)
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            bool enabled = change.Value is bool value && value;
            Report(await Api.PostAsync("api/notifications/email", new NotifyByEmailRequest(enabled), ApiJson.Default.NotifyByEmailRequest,
                enabled ? "You will get a message for each notification." : "No more messages; the inbox stays."));
            await Api.RefreshSessionAsync();
        }
        finally { busy = false; }
    }

    private async Task ClearEmail()
    {
        email = "";
        await SaveEmail();
    }

    private SshKeyResponse[] keys = [];
    private string keyTitle = "";
    private string keyText = "";
    private long? pendingKeyDelete;

    private async Task LoadKeys() => keys = await Api.GetAsync("api/keys", ApiJson.Default.SshKeyResponseArray) ?? [];

    private async Task AddKey()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync("api/keys", new SshKeyCreateRequest(keyTitle.Trim(), keyText.Trim(), null),
                ApiJson.Default.SshKeyCreateRequest, "Key added.");
            Report(result);
            if (result.Ok)
            {
                keyTitle = "";
                keyText = "";
                await LoadKeys();
            }
        }
        finally { busy = false; }
    }

    private async Task DeleteKey(SshKeyResponse key)
    {
        if (pendingKeyDelete != key.Id) { pendingKeyDelete = key.Id; return; }
        if (busy) return;
        busy = true;
        message = "";
        pendingKeyDelete = null;
        try
        {
            Report(await Api.DeleteAsync($"api/keys/{key.Id}", "Key removed."));
            await LoadKeys();
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Sends a completed avatar upload to be validated and stored. Refreshing the session afterwards is what
    /// makes the new image appear: the session carries the avatar URL, so the shell updates with it.
    /// </summary>
    private async Task SetAvatar(string uploadId)
    {
        if (busy || Api.Session is null) return;
        busy = true;
        try
        {
            Report(await Api.PostAsync($"api/graft/avatars/user/{Api.Session.UserId}",
                new UploadIngestRequest(uploadId), ApiJson.Default.UploadIngestRequest, "Avatar updated."));
            await Api.RefreshSessionAsync();
        }
        finally { busy = false; }
    }

    private async Task CreateToken()
    {
        if (busy) return;
        string[] scopes = Scopes();
        if (scopes.Length == 0) { Report(ApiResult.Refused("Select at least one token scope.")); return; }
        busy = true;
        message = "";
        created = null;
        rotated = false;
        collected = false;
        fallbackSecret = null;
        try
        {
            ApiResult<TokenCreatedResponse> result = await Api.SendAsync(HttpMethod.Post, "api/tokens",
                new TokenCreateRequest(tokenName, scopes, tokenLifetimeDays),
                ApiJson.Default.TokenCreateRequest, ApiJson.Default.TokenCreatedResponse, "Token created.");
            Report(new ApiResult(result.Ok, result.Message));
            if (!result.Ok) return;
            created = result.Value;
            tokenName = "";
            await LoadTokens();
        }
        finally { busy = false; }
    }

    /// <summary>
    /// Fetches the new token's secret and puts it on the clipboard without it ever entering the document.
    ///
    /// <para>
    /// The secret is held in a local for the few lines it takes to hand it to the clipboard, and is not
    /// kept in a field, so nothing renders it and nothing retains it. The server's handle is single use, so
    /// this button works once; the clipboard failing is the one case where the value has to be shown, since
    /// the alternative is losing a token that cannot be produced again.
    /// </para>
    /// </summary>
    private async Task CopyToken()
    {
        if (busy || created is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult<TokenRevealResponse> result = await Api.SendAsync(HttpMethod.Post, "api/tokens/reveal",
                new TokenRevealRequest(created.Reveal), ApiJson.Default.TokenRevealRequest,
                ApiJson.Default.TokenRevealResponse, "Copied.");
            if (!result.Ok || result.Value is null)
            {
                Report(new ApiResult(false, result.Message));
                return;
            }

            string secret = result.Value.Secret;
            bool copied;
            try { copied = await JS.InvokeAsync<bool>("graftClipboard.copy", secret); }
            catch (JSException) { copied = false; }

            if (copied) collected = true;
            else fallbackSecret = secret;
        }
        finally { busy = false; }
    }

    private void AskForSecret(TokenResponse token)
    {
        secretFor = token;
        secretPassword = "";
        message = "";
    }

    private void CancelSecret()
    {
        secretFor = null;
        secretPassword = "";
    }

    /// <summary>
    /// Reads an existing token's secret and puts it on the clipboard, never in the page. The password is
    /// cleared whatever happens, and the secret lives in a local for the few lines it takes to copy it.
    /// </summary>
    private async Task CopyExisting()
    {
        if (busy || secretFor is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult<TokenRevealResponse> result = await Api.SendAsync(HttpMethod.Post,
                $"api/tokens/{secretFor.Id}/secret", new TokenSecretRequest(secretPassword),
                ApiJson.Default.TokenSecretRequest, ApiJson.Default.TokenRevealResponse, "Copied.");
            secretPassword = "";
            if (!result.Ok || result.Value is null) { Report(new ApiResult(false, result.Message)); return; }

            bool copied;
            try { copied = await JS.InvokeAsync<bool>("graftClipboard.copy", result.Value.Secret); }
            catch (JSException) { copied = false; }

            if (copied)
            {
                Report(ApiResult.Accepted($"{secretFor.Name} copied to the clipboard."));
                secretFor = null;
            }
            else
            {
                // Shown only because the clipboard refused, and the reader would otherwise have confirmed a
                // password for nothing.
                fallbackSecret = result.Value.Secret;
                created = null;
                secretFor = null;
            }
        }
        finally { busy = false; }
    }

    /// <summary>The token whose Rotate button has been pressed once, waiting for the confirming click.</summary>
    private long? pendingRotate;
    /// <summary>Whether the secret waiting to be copied belongs to a rotated token rather than a new one.</summary>
    private bool rotated;

    /// <summary>
    /// Replaces a token's secret. The token keeps its name, scopes and expiry; the new secret is collected
    /// exactly as a new token's is, once and straight to the clipboard.
    /// </summary>
    private async Task RotateToken(TokenResponse token)
    {
        if (busy) return;
        if (pendingRotate != token.Id)
        {
            pendingRotate = token.Id;
            Report(ApiResult.Refused($"Select Confirm rotate to replace the secret of {token.Name}. Its current secret stops working at once."));
            return;
        }
        busy = true;
        message = "";
        created = null;
        collected = false;
        fallbackSecret = null;
        try
        {
            ApiResult<TokenCreatedResponse> result = await Api.SendAsync(HttpMethod.Post,
                $"api/tokens/{token.Id}/rotate", ApiJson.Default.TokenCreatedResponse, "Token rotated.");
            Report(new ApiResult(result.Ok, result.Message));
            pendingRotate = null;
            if (!result.Ok) return;
            created = result.Value;
            rotated = true;
            await LoadTokens();
        }
        finally { busy = false; }
    }

    private async Task RevokeToken(TokenResponse token)
    {
        if (busy) return;
        busy = true;
        message = "";
        created = null;
        try
        {
            Report(await Api.DeleteAsync($"api/tokens/{token.Id}", "Token revoked."));
            await LoadTokens();
        }
        finally { busy = false; }
    }

    private async Task ChangePassword()
    {
        if (busy) return;
        if (newPassword != confirmPassword) { Report(ApiResult.Refused("New passwords do not match.")); return; }
        busy = true;
        message = "";
        created = null;
        try
        {
            ApiResult result = await Api.PostAsync("api/password", new PasswordChangeRequest(currentPassword, newPassword),
                ApiJson.Default.PasswordChangeRequest, "Password changed. Sign in again.");
            currentPassword = ""; newPassword = ""; confirmPassword = "";
            Report(result);
            if (!result.Ok) return;
            // The server revoked this session, so the only coherent next step is signing in again.
            await Api.RefreshSessionAsync();
            Navigation.NavigateTo("/-/login?notice=password", replace: true);
        }
        finally { busy = false; }
    }

    private void Report(ApiResult result)
    {
        message = result.Message;
        messageKind = result.Ok ? "success" : "error";
    }

    private string[] Scopes()
    {
        List<string> scopes = [];
        if (scopeReadApi) scopes.Add("read_api");
        if (scopeApi) scopes.Add("api");
        if (scopeReadRepository) scopes.Add("read_repository");
        if (scopeWriteRepository) scopes.Add("write_repository");
        return [.. scopes];
    }

    private static string Initial(string value) => value.Length == 0 ? "?" : value[..1];
}
