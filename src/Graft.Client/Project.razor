@page "/{Namespace}/{Slug}"
@* The same page by the project's instance-wide slug, with no owner in the address. It renders here rather
   than redirecting to the owned path, because a redirect would put the username straight back in the
   address bar and undo the only thing this link is for. Every link the page builds therefore stays on
   whichever of the two routes the reader arrived by. *@
@page "/projects/{Slug}"
@inject GraftApi Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Slug &middot; Graft</PageTitle>

@if (loading)
{
    <p role="status" class="secondary-text">Loading repository…</p>
}
else if (repo is null)
{
    <div class="page-header"><div><h1>Repository unavailable</h1><p class="subtitle">@message</p></div></div>
    <a class="button secondary" href="/"><Icon Name="chevron-left" />Back to projects</a>
}
else
{
    <div class="repo-header">
        <Avatar Url="@repo.Project.AvatarUrl" Name="@repo.Project.Name" Class="avatar-large" />
        <div>
            <h1><span class="namespace">@repo.Project.Namespace.Name /</span> @repo.Project.Name</h1>
            <p class="subtitle">@(repo.Project.Description.Length > 0 ? repo.Project.Description : "No description")</p>
        </div>
        <VisibilityLabel Visibility="@repo.Project.Visibility" PagePublished="repo.PagePublished" />
        @if (repo.Project.ForkedFromProject is not null)
        {
            <span class="label accent">forked from <a href="@("/" + repo.Project.ForkedFromProject.PathWithNamespace)">@repo.Project.ForkedFromProject.PathWithNamespace</a></span>
        }
        @if (Api.Authenticated && !repo.CanManage)
        {
            <div class="page-header-actions">
                <button type="button" class="secondary" @onclick="Fork" disabled="@busy" title="Copy this project into your own namespace, to propose changes from">
                    <Icon Name="branch" />Fork@(repo.Project.ForksCount > 0 ? $" ({repo.Project.ForksCount})" : "")
                </button>
            </div>
        }
    </div>

    <Banner Message="@message" Kind="@messageKind" />

    @* Issues and merge requests are pages rather than tabs, because each one of them needs an address of
       its own: a link to an issue is the commonest thing anybody shares about a project. *@
    <div class="tabs">
        <button type="button" class="@(tab == "code" ? "active" : "")" @onclick='() => tab = "code"'>Code</button>
        <button type="button" class="@(tab == "commits" ? "active" : "")" @onclick='() => tab = "commits"'>Commits</button>
        <a href="@(ProjectBase + "/-/issues")">Issues</a>
        <a href="@(ProjectBase + "/-/merge-requests")">Merge requests</a>
        <a href="@(ProjectBase + "/-/boards")">Boards</a>
        <a href="@(ProjectBase + "/-/milestones")">Milestones</a>
        <a href="@(ProjectBase + "/-/releases")">Releases</a>
        <a href="@(ProjectBase + "/-/wiki")">Wiki</a>
        <a href="@(ProjectBase + "/-/snippets")">Snippets</a>
        <a href="@(ProjectBase + "/-/packages")">Packages</a>
        <a href="@(ProjectBase + "/-/search")">Search</a>
        @if (repo.CanPush)
        {
            <button type="button" class="@(tab == "upload" ? "active" : "")" @onclick='() => tab = "upload"'>Add files</button>
        }
        @if (repo.CanManage)
        {
            <button type="button" class="@(tab == "settings" ? "active" : "")" @onclick='() => tab = "settings"'>Settings</button>
        }
    </div>

    @* A repository nobody has pushed to yet. Shown as a state of its own rather than as an error, and it
       carries the commands that end it, because "empty" is only useful alongside what to do about it. *@
    @if (tab == "code" && repo.Branches.Count == 0)
    {
        <div class="panel">
            <div class="panel-header"><Icon Name="repository" /><h2>This repository is empty</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    Nothing has been pushed yet. Push an existing repository, or start one here.
                    @if (repo.CanPush)
                    {
                        <span>You can also add files from the Add files tab, which creates the first branch for you.</span>
                    }
                </p>
                <pre class="commit-message">git remote add origin @CloneAddress
git push -u origin main</pre>
                <p class="field-hint">
                    Pushing needs a personal access token as the password. Create one under Profile and tokens.
                </p>
            </div>
        </div>
    }
    else if (tab == "code")
    {
        <div class="panel overflowing">
            <div class="panel-header">
                <Icon Name="branch" />
                <label class="visually-hidden" for="branch-select">Branch</label>
                <select id="branch-select" class="branch-select" value="@Branch" @onchange="SwitchBranch">
                    @foreach (BranchResponse option in repo.Branches)
                    {
                        <option value="@option.Name" selected="@(option.Name == Branch)">@option.Name</option>
                    }
                </select>
                <span class="label">@repo.Branches.Count @(repo.Branches.Count == 1 ? "branch" : "branches")</span>
                @if (repo.Branches.FirstOrDefault(item => item.Name == Branch)?.Default == true)
                {
                    <span class="label accent">default</span>
                }
                @if (tags.Length > 0)
                {
                    <span class="label">@tags.Length @(tags.Length == 1 ? "tag" : "tags")</span>
                }
                <span class="spacer"></span>
                @* Served as an attachment of unknown type, so the browser saves it rather than rendering
                   somebody's repository on this origin. *@
                <a class="button secondary" href="@ArchiveUrl(".zip")" download>
                    <Icon Name="download" />Download
                </a>
                @* Arrive by the slug and the clone URL offered first is the slug's, so a reader who was
                   given an ownerless link is never handed back one with an account name in it. *@
                <CloneMenu Url="@(ViaSlug && repo.Project.GlobalWebUrl.Length > 0 ? repo.Project.GlobalWebUrl + ".git" : repo.Project.HttpUrlToRepo)"
                           Branch="@Branch" ShareUrl="@repo.Project.GlobalWebUrl" />
            </div>
        </div>

        <nav class="row" aria-label="Path">
            <button type="button" class="link" @onclick="() => Navigate(string.Empty)">@repo.Project.Name</button>
            @foreach ((string label, string target) in Crumbs())
            {
                <span class="muted">/</span>
                <button type="button" class="link" @onclick="() => Navigate(target)">@label</button>
            }
        </nav>

        <div class="file-table">
            <div class="file-table-header">
                <Icon Name="file" />
                <span>@repo.Tree.Count @(repo.Tree.Count == 1 ? "entry" : "entries")</span>
            </div>
            @if (path.Length > 0)
            {
                <button type="button" class="file-row" @onclick="Up">
                    <Icon Name="chevron-left" />
                    <span class="name">..</span>
                    <span class="meta">parent directory</span>
                </button>
            }
            @foreach (TreeEntryResponse entry in Ordered(repo.Tree))
            {
                <button type="button" class="file-row @(entry.Type == "tree" ? "tree" : "blob")" @onclick="() => Open(entry)">
                    <Icon Name="@(entry.Type == "tree" ? "folder" : "file")" />
                    <span class="name">@entry.Name</span>
                    <span class="meta mono">@entry.Mode</span>
                </button>
            }
            @if (repo.Tree.Count == 0)
            {
                <p class="panel-empty">This directory is empty.</p>
            }
        </div>

        @if (repo.Readme is not null && repo.File is null)
        {
            <div class="panel readme">
                <div class="panel-header"><Icon Name="file" /><strong>@repo.Readme.Path</strong></div>
                @* The HTML comes from the server's renderer, which parses with raw HTML disabled, validates
                   every link and image destination on the parsed tree, and refuses to emit markup at all if
                   its own output check fails. It is never repository HTML passed through. *@
                <div class="panel-body markdown">@((MarkupString)repo.Readme.Html)</div>
            </div>
        }

        @if (repo.File is not null)
        {
            <div class="panel blob-view">
                <div class="panel-header">
                    <Icon Name="file" />
                    <strong class="mono">@repo.File.FilePath</strong>
                    <span class="spacer"></span>
                    <span class="label">@repo.File.Size bytes</span>
                    @* The only way to get a binary file out of Graft short of cloning, and the only way to
                       get an exact copy of a text one. *@
                    <a class="button secondary" href="@RawUrl(repo.File.FilePath)" download>
                        <Icon Name="download" />Download
                    </a>
                </div>
                @if (fileText is null)
                {
                    <p class="panel-empty">Binary file. Graft does not render its contents.</p>
                }
                else
                {
                    <pre>@fileText</pre>
                }
            </div>
        }
    }
    else if (tab == "upload")
    {
        <div class="panel">
            <div class="panel-header"><Icon Name="upload" /><h2>Add files to @Branch</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    Files are uploaded first and committed when you choose. The server caps each file at the
                    limit its Git engine places on a single object, so a larger file is refused before it is staged.
                </p>
                <UploadField Profile="repository-file" Id="repository-files" OnCompleted="Staged" />

                @if (staged.Count > 0)
                {
                    <div class="list">
                        @foreach (StagedFile file in staged)
                        {
                            <div class="list-item">
                                <Icon Name="file" />
                                <span class="list-item-main">
                                    <label class="visually-hidden" for="@("path-" + file.UploadId)">Path in the repository</label>
                                    <input id="@("path-" + file.UploadId)" @bind="file.Path" maxlength="1024" />
                                    <small>@file.Name</small>
                                </span>
                                <span class="list-item-actions">
                                    <label class="checkbox"><input type="checkbox" @bind="file.Executable" /> Executable</label>
                                    <button type="button" class="secondary" @onclick="() => staged.Remove(file)" disabled="@committing">Remove</button>
                                </span>
                            </div>
                        }
                    </div>

                    <form class="form" @onsubmit="Commit" @onsubmit:preventDefault>
                        <label for="commit-message">Commit message</label>
                        <input id="commit-message" @bind="commitMessage" required maxlength="10000" />
                        <div class="form-actions">
                            <button type="submit" disabled="@committing">@(committing ? "Committing…" : "Commit " + staged.Count + (staged.Count == 1 ? " file" : " files"))</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
    else if (tab == "commits")
    {
        <div class="panel">
            <div class="panel-header"><h2>Recent commits</h2></div>
            <div class="list">
                @foreach (CommitResponse commit in repo.Commits)
                {
                    <a class="commit-row" href="@($"{ProjectBase}/-/commit/{commit.Id}")">
                        <code class="sha">@commit.ShortId</code>
                        <span class="list-item-main">
                            <strong>@commit.Title</strong>
                            <small>@commit.AuthorName &middot; @commit.AuthoredDate.ToString("u")</small>
                        </span>
                    </a>
                }
            </div>
            @if (repo.Commits.Count == 0) { <p class="panel-empty">No commits yet.</p> }
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Branches</h2></div>
            <div class="list">
                @foreach (BranchResponse branch in repo.Branches)
                {
                    <div class="branch-row">
                        <Icon Name="branch" />
                        <span class="list-item-main"><strong>@branch.Name</strong><small class="mono">@branch.Commit.ShortId</small></span>
                        @if (branch.Default) { <span class="label accent">default</span> }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="panel">
            <div class="panel-header"><Icon Name="lock" /><h2>Who can see this</h2></div>
            <div class="panel-body">
                @if (!repo.PublishingAllowed)
                {
                    <p class="secondary-text">
                        This server does not allow projects to be published, so every project stays private to
                        its members. An operator enables publishing when the server starts.
                    </p>
                }
                else
                {
                    <form class="form" @onsubmit="SetVisibility" @onsubmit:preventDefault>
                        <label for="visibility">Repository</label>
                        <select id="visibility" @bind="visibilityChoice">
                            <option value="private">Private &mdash; owner, members and administrators</option>
                            <option value="unlisted">Unlisted &mdash; anyone holding the link</option>
                            <option value="public">Public &mdash; anyone, and listed for everyone</option>
                        </select>
                        <p class="field-hint">
                            This covers the whole repository: every file, the history, and cloning. Unlisted is
                            not a secret and does not expire, because the link is the whole of the protection.
                        </p>
                        <div class="form-actions">
                            <button type="submit" disabled="@busy">Save visibility</button>
                        </div>
                    </form>

                    <hr />

                    <h3>Project page</h3>
                    <p class="secondary-text">
                        A page is a curated surface that can stand over a private repository, so you can share a
                        readme without sharing the code. It offers no clone, no history and no diff, because
                        those read the whole repository rather than the files you chose.
                    </p>
                    @if (repo.Project.Visibility == "public")
                    {
                        <div class="banner warning">
                            <Icon Name="alert" />
                            <span>
                                This repository is public, so its files are already readable by anyone. A page
                                changes how the project is presented here, and protects nothing while the
                                repository stays public.
                            </span>
                        </div>
                    }
                    <div class="form-actions">
                        <button type="button" class="@(repo.PagePublished ? "secondary" : "")"
                                @onclick="() => SetPagePublished(!repo.PagePublished)" disabled="@busy">
                            @(repo.PagePublished ? "Withdraw the project page" : "Publish a project page")
                        </button>
                        @if (repo.PagePublished) { <span class="label accent">published</span> }
                    </div>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><Icon Name="settings" /><h2>Name and description</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    How this project is listed and described. Neither is part of its address, so changing
                    them moves nothing and breaks no link.
                </p>
                <form class="form" @onsubmit="SaveDetails" @onsubmit:preventDefault>
                    <label for="project-name">Name</label>
                    <input id="project-name" @bind="nameChoice" required maxlength="200" />
                    <label for="project-description">Description</label>
                    <input id="project-description" @bind="descriptionChoice" maxlength="2000" />
                    <p class="field-hint">Shown in listings and on the project page. It may be left empty.</p>
                    <div class="form-actions">
                        <button type="submit" disabled="@(busy || !DetailsChanged)">Save name and description</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><Icon Name="branch" /><h2>Default branch</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    The branch this project opens at, and the one a clone checks out. Currently
                    <strong>@(repo.Project.DefaultBranch ?? "none, because the repository has no branches")</strong>.
                    With no branch chosen, Graft prefers <code>main</code>, then <code>master</code>, then the
                    first branch by name.
                </p>
                @if (repo.Branches.Count > 0)
                {
                    <form class="form" @onsubmit="SetDefaultBranch" @onsubmit:preventDefault>
                        <label for="default-branch">Open this project at</label>
                        <select id="default-branch" @bind="defaultBranchChoice">
                            <option value="">Follow convention</option>
                            @foreach (BranchResponse option in repo.Branches)
                            {
                                <option value="@option.Name">@option.Name</option>
                            }
                        </select>
                        <div class="form-actions">
                            <button type="submit" disabled="@busy">Save default branch</button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><Icon Name="user" /><h2>Transfer ownership</h2></div>
            <div class="panel-body">
                <div class="banner warning">
                    <Icon Name="alert" />
                    <span>
                        A project lives under its owner's name, so transferring moves it to
                        <strong>@(transferUsername.Length > 0 ? transferUsername : "the new owner")/@repo.Project.Path</strong>
                        and the current clone URL stops working. You keep access as a Maintainer.
                    </span>
                </div>
                <form class="form" @onsubmit="TransferOwnership" @onsubmit:preventDefault>
                    <label for="transfer-username">New owner</label>
                    <input id="transfer-username" @bind="transferUsername" @bind:event="oninput" required minlength="2" maxlength="39" />
                    <div class="form-actions">
                        <button type="submit" class="danger" disabled="@busy">@(busy ? "Transferring…" : "Transfer this project")</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><Icon Name="branch" /><h2>Branches</h2><span class="spacer"></span><span class="label">@repo.Branches.Count</span></div>
            <div class="panel-body">
                <form class="form inline" @onsubmit="CreateBranch" @onsubmit:preventDefault>
                    <label for="new-branch">New branch</label>
                    <input id="new-branch" @bind="newBranch" maxlength="255" autocomplete="off" placeholder="name" />
                    <label for="branch-from">from</label>
                    <select id="branch-from" @bind="newBranchFrom">
                        @foreach (BranchResponse option in repo.Branches) { <option value="@option.Name">@option.Name</option> }
                    </select>
                    <div class="form-actions">
                        <button type="submit" disabled="@(busy || newBranch.Trim().Length == 0)">Create branch</button>
                    </div>
                </form>
            </div>
            <div class="list">
                @foreach (BranchResponse option in repo.Branches)
                {
                    <div class="list-item">
                        <Icon Name="branch" />
                        <span class="list-item-main"><strong><code>@option.Name</code></strong></span>
                        @if (option.Default)
                        {
                            <span class="label accent">default</span>
                        }
                        <span class="list-item-actions">
                            @if (!option.Default)
                            {
                                <button type="button" class="@(pendingBranch == option.Name ? "danger" : "secondary")"
                                        @onclick="() => DeleteBranch(option.Name)" disabled="@busy">
                                    @(pendingBranch == option.Name ? "Confirm delete" : "Delete")
                                </button>
                            }
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><Icon Name="archive" /><h2>Tags</h2><span class="spacer"></span><span class="label">@tags.Length</span></div>
            <div class="panel-body">
                <form class="form inline" @onsubmit="CreateTag" @onsubmit:preventDefault>
                    <label for="new-tag">New tag</label>
                    <input id="new-tag" @bind="newTag" maxlength="255" autocomplete="off" placeholder="v1.0.0" />
                    <label for="tag-from">at</label>
                    <select id="tag-from" @bind="newTagFrom">
                        @foreach (BranchResponse option in repo.Branches) { <option value="@option.Name">@option.Name</option> }
                    </select>
                    <div class="form-actions">
                        <button type="submit" disabled="@(busy || newTag.Trim().Length == 0 || repo.Branches.Count == 0)">Create tag</button>
                    </div>
                </form>
            </div>
            @if (tags.Length == 0)
            {
                <div class="panel-empty">No tags. A tag pushed by a client appears here too.</div>
            }
            else
            {
                <div class="list">
                    @foreach (TagResponse tag in tags)
                    {
                        <div class="list-item">
                            <Icon Name="archive" />
                            <span class="list-item-main">
                                <strong><code>@tag.Name</code></strong>
                                <small>@tag.Commit.Title</small>
                            </span>
                            <span class="list-item-actions">
                                <a class="button secondary" href="@ArchiveUrl(".zip", tag.Name)" download>
                                    <Icon Name="download" />Download
                                </a>
                                <button type="button" class="@(pendingTag == tag.Name ? "danger" : "secondary")"
                                        @onclick="() => DeleteTag(tag.Name)" disabled="@busy">
                                    @(pendingTag == tag.Name ? "Confirm delete" : "Delete")
                                </button>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="panel">
            <div class="panel-header"><Icon Name="check" /><h2>Review</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    How many people must approve a merge request before it can be merged. An approval counts only
                    while the branch it was given against is still the branch being merged, so pushing to a
                    proposal supersedes the approvals of what came before. An author cannot approve their own.
                </p>
                <form class="form inline" @onsubmit="SaveApprovals" @onsubmit:preventDefault>
                    <label for="approvals-required">Approvals required</label>
                    <input id="approvals-required" type="number" min="0" max="10" @bind="approvalsRequired" />
                    <label class="checkbox">
                        <input type="checkbox" @bind="requireCodeOwnerApproval" />
                        Require a code owner's approval for every changed path a <code>CODEOWNERS</code> file names
                    </label>
                    <p class="field-hint">
                        The file is read from the target branch, at <code>CODEOWNERS</code>, <code>.graft/CODEOWNERS</code>,
                        <code>.gitlab/CODEOWNERS</code> or <code>docs/CODEOWNERS</code>. With no file the rule requires nothing.
                    </p>
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">Save</button>
                    </div>
                </form>
            </div>
        </div>

        @* Only where the operator allowed outbound requests. Elsewhere the routes are absent, so offering
           the controls would be offering something that answers 404. *@
        @if (Api.Session?.WebhooksAvailable == true)
        {
            <div class="panel">
                <div class="panel-header"><Icon Name="upload" /><h2>Webhooks</h2><span class="spacer"></span><span class="label">@hooks.Length</span></div>
                <div class="panel-body">
                    <div class="banner info">
                        <Icon Name="shield" />
                        <span>
                            Each delivery carries an <code>X-Graft-Signature</code> header: the text
                            <code>sha256=</code> followed by an HMAC of the exact body under the secret below.
                            Check it before trusting a delivery. The secret is stored but never shown again.
                        </span>
                    </div>
                    <form class="form" @onsubmit="CreateHook" @onsubmit:preventDefault>
                        <label for="hook-url">Address</label>
                        <input id="hook-url" @bind="hookUrl" maxlength="2048" autocomplete="off" placeholder="https://build.example/graft" />
                        <label for="hook-secret">Signing secret</label>
                        <input id="hook-secret" type="password" @bind="hookSecret" minlength="16" maxlength="256" autocomplete="off" />
                        <p class="field-hint">At least 16 characters. The receiver needs the same value.</p>
                        <fieldset class="checkbox-group">
                            <legend>Events</legend>
                            @foreach (string name in HookEvents)
                            {
                                <label class="checkbox">
                                    <input type="checkbox" checked="@hookEvents.Contains(name)"
                                           @onchange="args => ToggleHookEvent(name, args)" />
                                    @name
                                </label>
                            }
                        </fieldset>
                        <div class="form-actions">
                            <button type="submit" disabled="@busy">Add webhook</button>
                        </div>
                    </form>
                </div>
                @if (hooks.Length > 0)
                {
                    <div class="list">
                        @foreach (WebhookResponse hook in hooks)
                        {
                            <div class="list-item">
                                <span class="list-item-main">
                                    <strong><code>@hook.Url</code></strong>
                                    <small>
                                        @string.Join(", ", hook.Events) &middot; added by @hook.CreatedBy
                                        @if (hook.LastDeliveredAt is not null)
                                        {
                                            <span>
                                                &middot; last @(hook.LastStatus is not null
                                                    ? "answered " + hook.LastStatus
                                                    : "failed: " + hook.LastError)
                                            </span>
                                        }
                                    </small>
                                </span>
                                <span class="list-item-actions">
                                    <button type="button" class="secondary" @onclick="() => DeleteHook(hook)" disabled="@busy">Remove</button>
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div class="panel">
            <div class="panel-header"><Icon Name="repository" /><h2>Project avatar</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    PNG, JPEG, GIF or WebP, up to 2&nbsp;MB and 4096&nbsp;pixels on a side. SVG is not accepted.
                </p>
                <UploadField Profile="avatar" Id="project-avatar" OnCompleted="SetProjectAvatar" />
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Add or update a member</h2></div>
            <div class="panel-body">
                <form class="form" @onsubmit="SetMember" @onsubmit:preventDefault>
                    <label for="member-username">Username</label>
                    <input id="member-username" @bind="memberUsername" required minlength="2" maxlength="39" />
                    <label for="member-role">Role</label>
                    <select id="member-role" @bind="memberRole">
                        <option>Reporter</option>
                        <option>Developer</option>
                        <option>Maintainer</option>
                    </select>
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Saving…" : "Save member")</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Project members</h2><span class="spacer"></span><span class="label">@members.Length</span></div>
            @if (members.Length == 0)
            {
                <p class="panel-empty">No direct project members.</p>
            }
            else
            {
                <div class="list">
                    @foreach (ProjectMemberResponse member in members)
                    {
                        <div class="list-item">
                            <span class="avatar" aria-hidden="true">@Initial(member.Username)</span>
                            <span class="list-item-main"><strong>@member.Username</strong><small>@member.Role</small></span>
                            <span class="list-item-actions">
                                <button type="button" class="secondary" @onclick="() => RemoveMember(member)" disabled="@busy">Remove</button>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        @* Only the owner and an administrator, matching what the server will accept. A Maintainer sees no
           button rather than one that answers 403: offering an action nobody can take is worse than not
           offering it. *@
        @if (CanDelete)
        {
            <div class="panel danger-zone">
                <div class="panel-header"><Icon Name="alert" /><h2>Delete this project</h2></div>
                <div class="panel-body">
                    <div class="banner error">
                        <Icon Name="alert" />
                        <span>
                            This removes the repository, its history, its issues and its merge requests, and
                            it cannot be undone. Every clone URL and shared link stops working, and the path
                            becomes available for a new project.
                        </span>
                    </div>
                    <form class="form" @onsubmit="DeleteProject" @onsubmit:preventDefault>
                        <label for="delete-confirm">Type <strong>@ProjectPath</strong> to confirm</label>
                        <input id="delete-confirm" @bind="deleteConfirmation" @bind:event="oninput"
                               autocomplete="off" spellcheck="false" />
                        <div class="form-actions">
                            <button type="submit" class="danger" disabled="@(busy || deleteConfirmation.Trim() != ProjectPath)">
                                @(busy ? "Deleting…" : "Delete this project")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public string Slug { get; set; } = "";

    /// <summary>Whether the reader arrived by the instance-wide slug. The owned route always supplies a
    /// namespace, so its absence is what distinguishes the two.</summary>
    private bool ViaSlug => Namespace.Length == 0;

    /// <summary>The prefix every link on this page is built from, so navigating within a project never
    /// moves the reader onto the other route and never reveals an owner the link deliberately omitted.</summary>
    private string ProjectBase => ViaSlug
        ? $"/projects/{Uri.EscapeDataString(Slug)}"
        : $"/{Uri.EscapeDataString(Namespace)}/{Uri.EscapeDataString(Slug)}";

    /// <summary>The clone address to offer, matching the route the reader arrived by so a link shared
    /// without an account name does not hand one back.</summary>
    private string CloneAddress => repo is null
        ? ""
        : ViaSlug && repo.Project.GlobalWebUrl.Length > 0
            ? repo.Project.GlobalWebUrl + ".git"
            : repo.Project.HttpUrlToRepo;

    private RepositoryPageResponse? repo;
    private ProjectMemberResponse[] members = [];
    private string tab = "code";
    private string branch = "";
    private string defaultBranchChoice = "";
    private string nameChoice = "";
    private string descriptionChoice = "";
    private string visibilityChoice = "private";
    private string path = "";
    private string filePath = "";
    private string? fileText;
    private string message = "";
    private string messageKind = "info";
    private string memberUsername = "";
    private string memberRole = "Developer";
    private string transferUsername = "";
    private string deleteConfirmation = "";
    private string newBranch = "";
    private string newBranchFrom = "";
    private string? pendingBranch;
    private TagResponse[] tags = [];
    private string newTag = "";
    private string newTagFrom = "";
    private string? pendingTag;
    private int approvalsRequired;
    private bool requireCodeOwnerApproval;
    private WebhookResponse[] hooks = [];
    private string hookUrl = "";
    private string hookSecret = "";
    private readonly HashSet<string> hookEvents = new(StringComparer.Ordinal) { "push" };

    private static readonly string[] HookEvents = ["push", "issue", "merge_request", "comment"];
    private bool loading = true;
    private bool busy;

    /// <summary>A completed upload waiting to be committed. Mutable so the path field can be edited.</summary>
    private sealed class StagedFile
    {
        public required string UploadId { get; init; }
        public required string Name { get; init; }
        public string Path { get; set; } = "";
        public bool Executable { get; set; }
    }

    private readonly List<StagedFile> staged = [];
    private string commitMessage = "";
    private bool committing;

    /// <summary>
    /// Called when the browser reports a finished transfer. The event is a hint, so the session is read back
    /// from the server and only an upload the server agrees is complete is staged.
    /// </summary>
    private async Task Staged(string uploadId)
    {
        if (staged.Any(file => file.UploadId == uploadId)) return;
        UploadStatusResponse? status = await Api.GetAsync(
            $"api/graft/uploads/sessions/{uploadId}", ApiJson.Default.UploadStatusResponse);
        if (status is null || status.State != "complete") return;
        staged.Add(new StagedFile { UploadId = uploadId, Name = status.FileName, Path = status.FileName });
        StateHasChanged();
    }

    private async Task Commit()
    {
        if (committing || repo is null || staged.Count == 0) return;
        committing = true;
        message = "";
        try
        {
            RepositoryCommitRequest request = new(Branch, commitMessage,
                [.. staged.Select(file => new RepositoryFileUpload(file.UploadId, file.Path, file.Executable))]);
            ApiResult<RepositoryCommitResponse> result = await Api.SendAsync(HttpMethod.Post,
                $"api/graft/projects/{repo.Project.Id}/repository/files", request,
                ApiJson.Default.RepositoryCommitRequest, ApiJson.Default.RepositoryCommitResponse, "Committed.");
            Report(new ApiResult(result.Ok, result.Ok && result.Value is not null
                ? $"Committed {staged.Count} {(staged.Count == 1 ? "file" : "files")} as {result.Value.CommitId[..7]}."
                : result.Message));
            if (!result.Ok) return;
            staged.Clear();
            commitMessage = "";
            path = "";
            filePath = "";
            tab = "code";
            await Load();
        }
        finally { committing = false; }
    }

    /// <summary>
    /// Swaps mermaid code blocks for isolated diagram frames once the README is in the DOM. Done after
    /// render rather than during it because the diagram renderer lives in a sandboxed frame, and only when a
    /// README actually contains one, so a page without diagrams never fetches it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (repo?.Readme?.HasDiagrams != true) return;
        try { await JS.InvokeVoidAsync("graftMarkdown.render"); }
        catch (JSException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            // Not gated on a session. A public or unlisted project is readable without one, and a reader who
            // arrives at a link has no id to look the project up by: the listing that would have told them is
            // exactly what a stranger cannot read, so the path is the lookup key.
            await Api.EnsureSessionAsync();
            if (!Api.Reachable) { message = "Graft could not be reached."; return; }
            await Load();
            if (repo is null)
                // Absent, private, and shared-with-someone-else all answer identically, so this cannot say
                // which. Naming sign-in is the useful next step for a reader who has an account and is not
                // currently using it.
                message = Api.Authenticated
                    ? "You do not have access to this project."
                    : "This project is not public. Sign in if you have access to it.";
        }
        finally { loading = false; }
    }

    /// <summary>
    /// The branch being viewed. Empty means "whatever the project opens at", which the server resolves, so
    /// the first load does not have to guess a branch name that may not exist.
    /// </summary>
    private string Branch => branch.Length > 0 ? branch : repo?.Project.DefaultBranch ?? "";

    private async Task Load()
    {
        string reference = branch.Length > 0 ? branch : "HEAD";
        string query = (ViaSlug
                ? $"api/graft/slugs/{Uri.EscapeDataString(Slug)}"
                : $"api/browser/projects/{Uri.EscapeDataString(Namespace)}/{Uri.EscapeDataString(Slug)}") +
            $"?ref={Uri.EscapeDataString(reference)}&path={Uri.EscapeDataString(path)}" +
            (filePath.Length == 0 ? "" : "&file=" + Uri.EscapeDataString(filePath));
        (bool reached, RepositoryPageResponse? loaded) = await Api.GetOptionalAsync(query, ApiJson.Default.RepositoryPageResponse);
        if (!reached) { message = "Graft could not be reached."; return; }
        repo = loaded;
        fileText = repo?.File is null ? null : DecodeText(repo.File.Content);
        // The payload reports the branch actually in effect, whether that came from the stored preference
        // or from convention, so the settings selector starts on what the project is really opening at.
        defaultBranchChoice = repo?.Project.DefaultBranch ?? "";
        nameChoice = repo?.Project.Name ?? "";
        descriptionChoice = repo?.Project.Description ?? "";
        visibilityChoice = repo?.Project.Visibility ?? "private";
        if (newBranchFrom.Length == 0 || repo?.Branches.All(option => option.Name != newBranchFrom) == true)
            newBranchFrom = repo?.Project.DefaultBranch ?? repo?.Branches.FirstOrDefault()?.Name ?? "";
        approvalsRequired = repo?.ApprovalsRequired ?? 0;
        requireCodeOwnerApproval = repo?.RequireCodeOwnerApproval ?? false;
        if (newTagFrom.Length == 0 || repo?.Branches.All(option => option.Name != newTagFrom) == true)
            newTagFrom = newBranchFrom;
        if (repo is not null) await LoadTags();
        if (repo?.CanManage == true)
        {
            await LoadMembers(repo.Project.Id);
            await LoadHooks();
        }
    }

    /// <summary>Reloads just the repository view, after something that changed its branches.</summary>
    private Task LoadRepository() => Load();

    /// <summary>Switches branch, dropping the current path because it may not exist on the new one.</summary>
    private async Task SwitchBranch(ChangeEventArgs args)
    {
        if (repo is null) return;
        branch = args.Value?.ToString() ?? "";
        path = "";
        filePath = "";
        await Load();
    }

    /// <summary>
    /// Stores which branch the project opens at. An empty choice clears the preference, which returns the
    /// project to the convention the repository applies on its own.
    /// </summary>
    private async Task SetVisibility()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/visibility",
                new VisibilityRequest(visibilityChoice), ApiJson.Default.VisibilityRequest,
                visibilityChoice switch
                {
                    "public" => "Anyone can now read this repository, and it is listed for everyone.",
                    "unlisted" => "Anyone holding the link can now read this repository. It is not listed.",
                    _ => "This repository is private to its members again."
                });
            Report(result);
            if (result.Ok) await Load();
        }
        finally { busy = false; }
    }

    private async Task SetPagePublished(bool published)
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/page",
                new PagePublishRequest(published), ApiJson.Default.PagePublishRequest,
                published ? "The project page is published." : "The project page is withdrawn.");
            Report(result);
            if (result.Ok) await Load();
        }
        finally { busy = false; }
    }

    private bool DetailsChanged => repo is not null &&
        (nameChoice != repo.Project.Name || descriptionChoice != repo.Project.Description);

    private async Task SaveDetails()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/details",
                new ProjectDetailsRequest(nameChoice, descriptionChoice), ApiJson.Default.ProjectDetailsRequest,
                "Name and description saved.");
            Report(result);
            if (result.Ok) await Load();
        }
        finally { busy = false; }
    }

    private async Task SetDefaultBranch()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            string? choice = defaultBranchChoice.Length == 0 ? null : defaultBranchChoice;
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/default-branch",
                new DefaultBranchRequest(choice), ApiJson.Default.DefaultBranchRequest,
                choice is null ? "Default branch now follows convention." : $"{choice} is now the default branch.");
            Report(result);
            if (result.Ok) await Load();
        }
        finally { busy = false; }
    }

    private async Task Open(TreeEntryResponse entry)
    {
        if (entry.Type == "tree") { path = entry.Path; filePath = ""; }
        else { filePath = entry.Path; }
        if (repo is not null) await Load();
    }

    private async Task Navigate(string target)
    {
        path = target;
        filePath = "";
        if (repo is not null) await Load();
    }

    private async Task Up()
    {
        int separator = path.LastIndexOf('/');
        await Navigate(separator < 0 ? "" : path[..separator]);
    }

    /// <summary>Breadcrumb segments with the path each one navigates to.</summary>
    private IEnumerable<(string Label, string Target)> Crumbs()
    {
        if (path.Length == 0) yield break;
        string[] segments = path.Split('/');
        for (int index = 0; index < segments.Length; index++)
            yield return (segments[index], string.Join('/', segments[..(index + 1)]));
    }

    /// <summary>Directories before files, then by name, which is how both GitLab and GitHub order a tree.</summary>
    private static IEnumerable<TreeEntryResponse> Ordered(IReadOnlyList<TreeEntryResponse> tree) => tree
        .OrderByDescending(entry => entry.Type == "tree")
        .ThenBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Hands the project to another account. On success the project has moved, so this navigates to the new
    /// path rather than reloading: the page the browser is on no longer resolves.
    /// </summary>
    /// <summary>
    /// Deleting needs the owner or an administrator, which is stricter than managing the project. The
    /// server decides; this only decides whether to show a control.
    ///
    /// <para>
    /// The owner is recognised by the namespace matching the signed-in account, because the repository
    /// payload reports the owning namespace and not an owner id. That holds for every project reachable
    /// here: a project's namespace is its owner's account name.
    /// </para>
    /// </summary>
    private bool CanDelete => repo is not null && (Api.IsAdministrator ||
        string.Equals(repo.Project.Namespace.Path, Api.Username, StringComparison.OrdinalIgnoreCase));

    private string ProjectPath => repo is null ? "" : repo.Project.Namespace.Path + "/" + repo.Project.Path;

    /// <summary>
    /// The archive and raw addresses are built as plain links rather than fetched, so the browser's own
    /// download handling applies and a large archive never passes through this page's memory.
    /// </summary>
    private string ArchiveUrl(string format, string? revision = null) => repo is null
        ? ""
        : $"/api/projects/{repo.Project.Id}/archive{format}?sha=" + Uri.EscapeDataString(revision ?? Branch);

    // Graft's own route rather than the GitLab-shaped one, which answers a token and would refuse this
    // page's session.
    private string RawUrl(string filePath) => repo is null
        ? ""
        : $"/api/projects/{repo.Project.Id}/raw/{filePath}?ref=" + Uri.EscapeDataString(Branch);

    private async Task LoadTags()
    {
        if (repo is null) return;
        tags = await Api.GetAsync($"api/projects/{repo.Project.Id}/tags", ApiJson.Default.TagResponseArray) ?? [];
    }

    private async Task CreateTag()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            string at = newTagFrom.Length > 0 ? newTagFrom : Branch;
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/tags",
                new TagCreateRequest(newTag.Trim(), at), ApiJson.Default.TagCreateRequest,
                $"{newTag.Trim()} tagged at {at}.");
            Report(result);
            if (!result.Ok) return;
            newTag = "";
            await LoadTags();
        }
        finally { busy = false; }
    }

    /// <summary>Deleting a tag needs a second click, like deleting a branch: a tag is how a release is
    /// identified, and removing one silently would strand whatever referred to it.</summary>
    private async Task DeleteTag(string tag)
    {
        if (busy || repo is null) return;
        if (pendingTag != tag)
        {
            pendingTag = tag;
            Report(ApiResult.Refused($"Select Confirm delete to remove the tag {tag}. Its commits stay in the repository."));
            return;
        }
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.DeleteAsync(
                $"api/projects/{repo.Project.Id}/tags/{Uri.EscapeDataString(tag)}", $"Tag {tag} deleted.");
            Report(result);
            pendingTag = null;
            if (result.Ok) await LoadTags();
        }
        finally { busy = false; }
    }

    private async Task CreateBranch()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            string from = newBranchFrom.Length > 0 ? newBranchFrom : Branch;
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/branches",
                new BranchCreateRequest(newBranch.Trim(), from), ApiJson.Default.BranchCreateRequest,
                $"{newBranch.Trim()} created from {from}.");
            Report(result);
            if (!result.Ok) return;
            newBranch = "";
            await LoadRepository();
        }
        finally { busy = false; }
    }

    /// <summary>Deleting a branch needs a second click: the first arms it, so a stray click cannot remove
    /// a branch somebody is working on.</summary>
    private async Task DeleteBranch(string branch)
    {
        if (busy || repo is null) return;
        if (pendingBranch != branch)
        {
            pendingBranch = branch;
            Report(ApiResult.Refused($"Select Confirm delete to remove {branch}. Its commits stay in the repository."));
            return;
        }
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.DeleteAsync(
                $"api/projects/{repo.Project.Id}/branches/{Uri.EscapeDataString(branch)}", $"{branch} deleted.");
            Report(result);
            pendingBranch = null;
            if (result.Ok) await LoadRepository();
        }
        finally { busy = false; }
    }

    private async Task Fork()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult<ProjectResponse> result = await Api.SendAsync<VisibilityRequest, ProjectResponse>(HttpMethod.Post,
                $"api/projects/{repo.Project.Id}/fork", new VisibilityRequest(null), ApiJson.Default.VisibilityRequest,
                ApiJson.Default.ProjectResponse, "Forked.");
            if (!result.Ok || result.Value is null) { message = result.Message; messageKind = "error"; return; }
            Navigation.NavigateTo("/" + result.Value.PathWithNamespace);
        }
        finally { busy = false; }
    }

    private async Task SaveApprovals()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/approvals",
                new ApprovalsRequiredRequest(approvalsRequired, requireCodeOwnerApproval), ApiJson.Default.ApprovalsRequiredRequest,
                (approvalsRequired == 0
                    ? "Merge requests no longer need a number of approvals."
                    : $"Merge requests now need {approvalsRequired} approvals.") +
                (requireCodeOwnerApproval ? " Code owners must approve the paths they own." : ""));
            Report(result);
        }
        finally { busy = false; }
    }

    private void ToggleHookEvent(string name, ChangeEventArgs args)
    {
        if (args.Value is true) hookEvents.Add(name);
        else hookEvents.Remove(name);
    }

    private async Task LoadHooks()
    {
        if (repo is null || Api.Session?.WebhooksAvailable != true || !repo.CanManage) return;
        hooks = await Api.GetAsync($"api/projects/{repo.Project.Id}/hooks", ApiJson.Default.WebhookResponseArray) ?? [];
    }

    private async Task CreateHook()
    {
        if (busy || repo is null) return;
        if (hookEvents.Count == 0) { Report(ApiResult.Refused("Choose at least one event.")); return; }
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/hooks",
                new WebhookCreateRequest(hookUrl.Trim(), hookSecret, [.. hookEvents]),
                ApiJson.Default.WebhookCreateRequest, "Webhook added.");
            // Cleared whatever the outcome: a secret that stayed in the form after a refusal would sit in
            // the page until the reader navigated away.
            hookSecret = "";
            Report(result);
            if (!result.Ok) return;
            hookUrl = "";
            await LoadHooks();
        }
        finally { busy = false; }
    }

    private async Task DeleteHook(WebhookResponse hook)
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.DeleteAsync($"api/projects/{repo.Project.Id}/hooks/{hook.Id}", "Webhook removed.");
            Report(result);
            if (result.Ok) await LoadHooks();
        }
        finally { busy = false; }
    }

    private async Task DeleteProject()
    {
        if (busy || repo is null) return;
        if (deleteConfirmation.Trim() != ProjectPath)
        {
            Report(ApiResult.Refused($"Type {ProjectPath} to confirm."));
            return;
        }
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.SendAsync(HttpMethod.Delete, $"api/projects/{repo.Project.Id}",
                JsonContent.Create(new ProjectDeleteRequest(ProjectPath), ApiJson.Default.ProjectDeleteRequest),
                "Project deleted.");
            Report(result);
            // Away from a page whose project no longer exists. Replacing the history entry, so Back does
            // not return to a repository view that can only fail now.
            if (result.Ok) Navigation.NavigateTo("/", replace: true);
        }
        finally { busy = false; }
    }

    private async Task TransferOwnership()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            string target = transferUsername.Trim();
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/owner",
                new OwnershipTransferRequest(target), ApiJson.Default.OwnershipTransferRequest,
                $"Project transferred to {target}.");
            Report(result);
            if (result.Ok) Navigation.NavigateTo($"/{target}/{repo.Project.Path}", forceLoad: false);
        }
        finally { busy = false; }
    }

    /// <summary>Stores a completed upload as the project avatar, then reloads so the new image shows.</summary>
    private async Task SetProjectAvatar(string uploadId)
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/graft/avatars/project/{repo.Project.Id}",
                new UploadIngestRequest(uploadId), ApiJson.Default.UploadIngestRequest, "Project avatar updated.");
            Report(result);
            if (result.Ok) await Load();
        }
        finally { busy = false; }
    }

    private async Task LoadMembers(long projectId) => members =
        await Api.GetAsync($"api/projects/{projectId}/members", ApiJson.Default.ProjectMemberResponseArray) ?? [];

    private async Task SetMember()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/members",
                new MembershipSetRequest(memberUsername, memberRole), ApiJson.Default.MembershipSetRequest, "Membership saved.");
            Report(result);
            if (!result.Ok) return;
            memberUsername = "";
            await LoadMembers(repo.Project.Id);
        }
        finally { busy = false; }
    }

    private async Task RemoveMember(ProjectMemberResponse member)
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            Report(await Api.DeleteAsync($"api/projects/{repo.Project.Id}/members/{member.UserId}", "Membership removed."));
            await LoadMembers(repo.Project.Id);
        }
        finally { busy = false; }
    }

    private void Report(ApiResult result)
    {
        message = result.Message;
        messageKind = result.Ok ? "success" : "error";
    }

    /// <summary>Returns null for anything that is not valid UTF-8 text, so binary blobs are never rendered.</summary>
    private static string? DecodeText(string content)
    {
        byte[] bytes = Convert.FromBase64String(content);
        if (bytes.Contains((byte)0)) return null;
        try { return new UTF8Encoding(false, true).GetString(bytes); }
        catch (DecoderFallbackException) { return null; }
    }

    private static string Initial(string value) => value.Length == 0 ? "?" : value[..1];
}
