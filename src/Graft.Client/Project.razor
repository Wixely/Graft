@page "/{Namespace}/{Slug}"
@inject GraftApi Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@Slug &middot; Graft</PageTitle>

@if (loading)
{
    <p role="status" class="secondary-text">Loading repository…</p>
}
else if (repo is null)
{
    <div class="page-header"><div><h1>Repository unavailable</h1><p class="subtitle">@message</p></div></div>
    <a class="button secondary" href="/"><Icon Name="chevron-left" />Back to projects</a>
}
else
{
    <div class="repo-header">
        <Avatar Url="@repo.Project.AvatarUrl" Name="@repo.Project.Name" Class="avatar-large" />
        <div>
            <h1><span class="namespace">@repo.Project.Namespace.Name /</span> @repo.Project.Name</h1>
            <p class="subtitle">@(repo.Project.Description.Length > 0 ? repo.Project.Description : "No description")</p>
        </div>
        <span class="label"><Icon Name="lock" />Private</span>
    </div>

    <Banner Message="@message" Kind="@messageKind" />

    <div class="tabs">
        <button type="button" class="@(tab == "code" ? "active" : "")" @onclick='() => tab = "code"'>Code</button>
        <button type="button" class="@(tab == "commits" ? "active" : "")" @onclick='() => tab = "commits"'>Commits</button>
        @if (repo.CanPush)
        {
            <button type="button" class="@(tab == "upload" ? "active" : "")" @onclick='() => tab = "upload"'>Add files</button>
        }
        @if (repo.CanManage)
        {
            <button type="button" class="@(tab == "settings" ? "active" : "")" @onclick='() => tab = "settings"'>Members</button>
        }
    </div>

    @if (tab == "code")
    {
        <div class="panel">
            <div class="panel-header">
                <Icon Name="branch" />
                <label class="visually-hidden" for="branch-select">Branch</label>
                <select id="branch-select" class="branch-select" value="@Branch" @onchange="SwitchBranch">
                    @foreach (BranchResponse option in repo.Branches)
                    {
                        <option value="@option.Name" selected="@(option.Name == Branch)">@option.Name</option>
                    }
                </select>
                <span class="label">@repo.Branches.Count @(repo.Branches.Count == 1 ? "branch" : "branches")</span>
                @if (repo.Branches.FirstOrDefault(item => item.Name == Branch)?.Default == true)
                {
                    <span class="label accent">default</span>
                }
                <span class="spacer"></span>
                <div class="clone-url">
                    <label class="visually-hidden" for="clone">Clone URL</label>
                    <input id="clone" readonly value="@repo.Project.HttpUrlToRepo" />
                </div>
            </div>
        </div>

        <nav class="row" aria-label="Path">
            <button type="button" class="link" @onclick="() => Navigate(string.Empty)">@repo.Project.Name</button>
            @foreach ((string label, string target) in Crumbs())
            {
                <span class="muted">/</span>
                <button type="button" class="link" @onclick="() => Navigate(target)">@label</button>
            }
        </nav>

        <div class="file-table">
            <div class="file-table-header">
                <Icon Name="file" />
                <span>@repo.Tree.Count @(repo.Tree.Count == 1 ? "entry" : "entries")</span>
            </div>
            @if (path.Length > 0)
            {
                <button type="button" class="file-row" @onclick="Up">
                    <Icon Name="chevron-left" />
                    <span class="name">..</span>
                    <span class="meta">parent directory</span>
                </button>
            }
            @foreach (TreeEntryResponse entry in Ordered(repo.Tree))
            {
                <button type="button" class="file-row @(entry.Type == "tree" ? "tree" : "blob")" @onclick="() => Open(entry)">
                    <Icon Name="@(entry.Type == "tree" ? "folder" : "file")" />
                    <span class="name">@entry.Name</span>
                    <span class="meta mono">@entry.Mode</span>
                </button>
            }
            @if (repo.Tree.Count == 0)
            {
                <p class="panel-empty">This directory is empty.</p>
            }
        </div>

        @if (repo.Readme is not null && repo.File is null)
        {
            <div class="panel readme">
                <div class="panel-header"><Icon Name="file" /><strong>@repo.Readme.Path</strong></div>
                @* The HTML comes from the server's renderer, which parses with raw HTML disabled, validates
                   every link and image destination on the parsed tree, and refuses to emit markup at all if
                   its own output check fails. It is never repository HTML passed through. *@
                <div class="panel-body markdown">@((MarkupString)repo.Readme.Html)</div>
            </div>
        }

        @if (repo.File is not null)
        {
            <div class="panel blob-view">
                <div class="panel-header">
                    <Icon Name="file" />
                    <strong class="mono">@repo.File.FilePath</strong>
                    <span class="spacer"></span>
                    <span class="label">@repo.File.Size bytes</span>
                </div>
                @if (fileText is null)
                {
                    <p class="panel-empty">Binary file. Graft does not render its contents.</p>
                }
                else
                {
                    <pre>@fileText</pre>
                }
            </div>
        }
    }
    else if (tab == "upload")
    {
        <div class="panel">
            <div class="panel-header"><Icon Name="upload" /><h2>Add files to @Branch</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    Files are uploaded first and committed when you choose. The server caps each file at the
                    limit its Git engine places on a single object, so a larger file is refused before it is staged.
                </p>
                <UploadField Profile="repository-file" Id="repository-files" OnCompleted="Staged" />

                @if (staged.Count > 0)
                {
                    <div class="list">
                        @foreach (StagedFile file in staged)
                        {
                            <div class="list-item">
                                <Icon Name="file" />
                                <span class="list-item-main">
                                    <label class="visually-hidden" for="@("path-" + file.UploadId)">Path in the repository</label>
                                    <input id="@("path-" + file.UploadId)" @bind="file.Path" maxlength="1024" />
                                    <small>@file.Name</small>
                                </span>
                                <span class="list-item-actions">
                                    <label class="checkbox"><input type="checkbox" @bind="file.Executable" /> Executable</label>
                                    <button type="button" class="secondary" @onclick="() => staged.Remove(file)" disabled="@committing">Remove</button>
                                </span>
                            </div>
                        }
                    </div>

                    <form class="form" @onsubmit="Commit" @onsubmit:preventDefault>
                        <label for="commit-message">Commit message</label>
                        <input id="commit-message" @bind="commitMessage" required maxlength="10000" />
                        <div class="form-actions">
                            <button type="submit" disabled="@committing">@(committing ? "Committing…" : "Commit " + staged.Count + (staged.Count == 1 ? " file" : " files"))</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
    else if (tab == "commits")
    {
        <div class="panel">
            <div class="panel-header"><h2>Recent commits</h2></div>
            <div class="list">
                @foreach (CommitResponse commit in repo.Commits)
                {
                    <article class="commit-row">
                        <code class="sha">@commit.ShortId</code>
                        <span class="list-item-main">
                            <strong>@commit.Title</strong>
                            <small>@commit.AuthorName &middot; @commit.AuthoredDate.ToString("u")</small>
                        </span>
                    </article>
                }
            </div>
            @if (repo.Commits.Count == 0) { <p class="panel-empty">No commits yet.</p> }
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Branches</h2></div>
            <div class="list">
                @foreach (BranchResponse branch in repo.Branches)
                {
                    <div class="branch-row">
                        <Icon Name="branch" />
                        <span class="list-item-main"><strong>@branch.Name</strong><small class="mono">@branch.Commit.ShortId</small></span>
                        @if (branch.Default) { <span class="label accent">default</span> }
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="panel">
            <div class="panel-header"><Icon Name="branch" /><h2>Default branch</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    The branch this project opens at, and the one a clone checks out. Currently
                    <strong>@(repo.Project.DefaultBranch ?? "none, because the repository has no branches")</strong>.
                    With no branch chosen, Graft prefers <code>main</code>, then <code>master</code>, then the
                    first branch by name.
                </p>
                @if (repo.Branches.Count > 0)
                {
                    <form class="form" @onsubmit="SetDefaultBranch" @onsubmit:preventDefault>
                        <label for="default-branch">Open this project at</label>
                        <select id="default-branch" @bind="defaultBranchChoice">
                            <option value="">Follow convention</option>
                            @foreach (BranchResponse option in repo.Branches)
                            {
                                <option value="@option.Name">@option.Name</option>
                            }
                        </select>
                        <div class="form-actions">
                            <button type="submit" disabled="@busy">Save default branch</button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><Icon Name="user" /><h2>Transfer ownership</h2></div>
            <div class="panel-body">
                <div class="banner warning">
                    <Icon Name="alert" />
                    <span>
                        A project lives under its owner's name, so transferring moves it to
                        <strong>@(transferUsername.Length > 0 ? transferUsername : "the new owner")/@repo.Project.Path</strong>
                        and the current clone URL stops working. You keep access as a Maintainer.
                    </span>
                </div>
                <form class="form" @onsubmit="TransferOwnership" @onsubmit:preventDefault>
                    <label for="transfer-username">New owner</label>
                    <input id="transfer-username" @bind="transferUsername" @bind:event="oninput" required minlength="2" maxlength="39" />
                    <div class="form-actions">
                        <button type="submit" class="danger" disabled="@busy">@(busy ? "Transferring…" : "Transfer this project")</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><Icon Name="repository" /><h2>Project avatar</h2></div>
            <div class="panel-body">
                <p class="secondary-text">
                    PNG, JPEG, GIF or WebP, up to 2&nbsp;MB and 4096&nbsp;pixels on a side. SVG is not accepted.
                </p>
                <UploadField Profile="avatar" Id="project-avatar" OnCompleted="SetProjectAvatar" />
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Add or update a member</h2></div>
            <div class="panel-body">
                <form class="form" @onsubmit="SetMember" @onsubmit:preventDefault>
                    <label for="member-username">Username</label>
                    <input id="member-username" @bind="memberUsername" required minlength="2" maxlength="39" />
                    <label for="member-role">Role</label>
                    <select id="member-role" @bind="memberRole">
                        <option>Reporter</option>
                        <option>Developer</option>
                        <option>Maintainer</option>
                    </select>
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Saving…" : "Save member")</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header"><h2>Project members</h2><span class="spacer"></span><span class="label">@members.Length</span></div>
            @if (members.Length == 0)
            {
                <p class="panel-empty">No direct project members.</p>
            }
            else
            {
                <div class="list">
                    @foreach (ProjectMemberResponse member in members)
                    {
                        <div class="list-item">
                            <span class="avatar" aria-hidden="true">@Initial(member.Username)</span>
                            <span class="list-item-main"><strong>@member.Username</strong><small>@member.Role</small></span>
                            <span class="list-item-actions">
                                <button type="button" class="secondary" @onclick="() => RemoveMember(member)" disabled="@busy">Remove</button>
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public string Slug { get; set; } = "";

    private RepositoryPageResponse? repo;
    private ProjectMemberResponse[] members = [];
    private string tab = "code";
    private string branch = "";
    private string defaultBranchChoice = "";
    private string path = "";
    private string filePath = "";
    private string? fileText;
    private string message = "";
    private string messageKind = "info";
    private string memberUsername = "";
    private string memberRole = "Developer";
    private string transferUsername = "";
    private bool loading = true;
    private bool busy;

    /// <summary>A completed upload waiting to be committed. Mutable so the path field can be edited.</summary>
    private sealed class StagedFile
    {
        public required string UploadId { get; init; }
        public required string Name { get; init; }
        public string Path { get; set; } = "";
        public bool Executable { get; set; }
    }

    private readonly List<StagedFile> staged = [];
    private string commitMessage = "";
    private bool committing;

    /// <summary>
    /// Called when the browser reports a finished transfer. The event is a hint, so the session is read back
    /// from the server and only an upload the server agrees is complete is staged.
    /// </summary>
    private async Task Staged(string uploadId)
    {
        if (staged.Any(file => file.UploadId == uploadId)) return;
        UploadStatusResponse? status = await Api.GetAsync(
            $"api/graft/uploads/sessions/{uploadId}", ApiJson.Default.UploadStatusResponse);
        if (status is null || status.State != "complete") return;
        staged.Add(new StagedFile { UploadId = uploadId, Name = status.FileName, Path = status.FileName });
        StateHasChanged();
    }

    private async Task Commit()
    {
        if (committing || repo is null || staged.Count == 0) return;
        committing = true;
        message = "";
        try
        {
            RepositoryCommitRequest request = new(Branch, commitMessage,
                [.. staged.Select(file => new RepositoryFileUpload(file.UploadId, file.Path, file.Executable))]);
            ApiResult<RepositoryCommitResponse> result = await Api.SendAsync(HttpMethod.Post,
                $"api/graft/projects/{repo.Project.Id}/repository/files", request,
                ApiJson.Default.RepositoryCommitRequest, ApiJson.Default.RepositoryCommitResponse, "Committed.");
            Report(new ApiResult(result.Ok, result.Ok && result.Value is not null
                ? $"Committed {staged.Count} {(staged.Count == 1 ? "file" : "files")} as {result.Value.CommitId[..7]}."
                : result.Message));
            if (!result.Ok) return;
            staged.Clear();
            commitMessage = "";
            path = "";
            filePath = "";
            tab = "code";
            await Load(repo.Project.Id);
        }
        finally { committing = false; }
    }

    /// <summary>
    /// Swaps mermaid code blocks for isolated diagram frames once the README is in the DOM. Done after
    /// render rather than during it because the diagram renderer lives in a sandboxed frame, and only when a
    /// README actually contains one, so a page without diagrams never fetches it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (repo?.Readme?.HasDiagrams != true) return;
        try { await JS.InvokeVoidAsync("graftMarkdown.render"); }
        catch (JSException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            if (!await Api.EnsureSessionAsync())
            {
                if (Api.Reachable) Navigation.NavigateTo("/-/login", replace: true);
                else message = "Graft could not be reached.";
                return;
            }
            ProjectResponse[] projects = await Api.GetAsync("api/projects", ApiJson.Default.ProjectResponseArray) ?? [];
            ProjectResponse? project = projects.SingleOrDefault(item => item.PathWithNamespace == Namespace + "/" + Slug);
            if (project is null) { message = "You do not have access to this project."; return; }
            await Load(project.Id);
        }
        finally { loading = false; }
    }

    /// <summary>
    /// The branch being viewed. Empty means "whatever the project opens at", which the server resolves, so
    /// the first load does not have to guess a branch name that may not exist.
    /// </summary>
    private string Branch => branch.Length > 0 ? branch : repo?.Project.DefaultBranch ?? "";

    private async Task Load(long id)
    {
        string reference = branch.Length > 0 ? branch : "HEAD";
        string query = $"api/browser/projects/{id}?ref={Uri.EscapeDataString(reference)}&path={Uri.EscapeDataString(path)}" +
            (filePath.Length == 0 ? "" : "&file=" + Uri.EscapeDataString(filePath));
        repo = await Api.GetAsync(query, ApiJson.Default.RepositoryPageResponse);
        fileText = repo?.File is null ? null : DecodeText(repo.File.Content);
        // The payload reports the branch actually in effect, whether that came from the stored preference
        // or from convention, so the settings selector starts on what the project is really opening at.
        defaultBranchChoice = repo?.Project.DefaultBranch ?? "";
        if (repo?.CanManage == true) await LoadMembers(id);
    }

    /// <summary>Switches branch, dropping the current path because it may not exist on the new one.</summary>
    private async Task SwitchBranch(ChangeEventArgs args)
    {
        if (repo is null) return;
        branch = args.Value?.ToString() ?? "";
        path = "";
        filePath = "";
        await Load(repo.Project.Id);
    }

    /// <summary>
    /// Stores which branch the project opens at. An empty choice clears the preference, which returns the
    /// project to the convention the repository applies on its own.
    /// </summary>
    private async Task SetDefaultBranch()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            string? choice = defaultBranchChoice.Length == 0 ? null : defaultBranchChoice;
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/default-branch",
                new DefaultBranchRequest(choice), ApiJson.Default.DefaultBranchRequest,
                choice is null ? "Default branch now follows convention." : $"{choice} is now the default branch.");
            Report(result);
            if (result.Ok) await Load(repo.Project.Id);
        }
        finally { busy = false; }
    }

    private async Task Open(TreeEntryResponse entry)
    {
        if (entry.Type == "tree") { path = entry.Path; filePath = ""; }
        else { filePath = entry.Path; }
        if (repo is not null) await Load(repo.Project.Id);
    }

    private async Task Navigate(string target)
    {
        path = target;
        filePath = "";
        if (repo is not null) await Load(repo.Project.Id);
    }

    private async Task Up()
    {
        int separator = path.LastIndexOf('/');
        await Navigate(separator < 0 ? "" : path[..separator]);
    }

    /// <summary>Breadcrumb segments with the path each one navigates to.</summary>
    private IEnumerable<(string Label, string Target)> Crumbs()
    {
        if (path.Length == 0) yield break;
        string[] segments = path.Split('/');
        for (int index = 0; index < segments.Length; index++)
            yield return (segments[index], string.Join('/', segments[..(index + 1)]));
    }

    /// <summary>Directories before files, then by name, which is how both GitLab and GitHub order a tree.</summary>
    private static IEnumerable<TreeEntryResponse> Ordered(IReadOnlyList<TreeEntryResponse> tree) => tree
        .OrderByDescending(entry => entry.Type == "tree")
        .ThenBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Hands the project to another account. On success the project has moved, so this navigates to the new
    /// path rather than reloading: the page the browser is on no longer resolves.
    /// </summary>
    private async Task TransferOwnership()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            string target = transferUsername.Trim();
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/owner",
                new OwnershipTransferRequest(target), ApiJson.Default.OwnershipTransferRequest,
                $"Project transferred to {target}.");
            Report(result);
            if (result.Ok) Navigation.NavigateTo($"/{target}/{repo.Project.Path}", forceLoad: false);
        }
        finally { busy = false; }
    }

    /// <summary>Stores a completed upload as the project avatar, then reloads so the new image shows.</summary>
    private async Task SetProjectAvatar(string uploadId)
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/graft/avatars/project/{repo.Project.Id}",
                new UploadIngestRequest(uploadId), ApiJson.Default.UploadIngestRequest, "Project avatar updated.");
            Report(result);
            if (result.Ok) await Load(repo.Project.Id);
        }
        finally { busy = false; }
    }

    private async Task LoadMembers(long projectId) => members =
        await Api.GetAsync($"api/projects/{projectId}/members", ApiJson.Default.ProjectMemberResponseArray) ?? [];

    private async Task SetMember()
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.PostAsync($"api/projects/{repo.Project.Id}/members",
                new MembershipSetRequest(memberUsername, memberRole), ApiJson.Default.MembershipSetRequest, "Membership saved.");
            Report(result);
            if (!result.Ok) return;
            memberUsername = "";
            await LoadMembers(repo.Project.Id);
        }
        finally { busy = false; }
    }

    private async Task RemoveMember(ProjectMemberResponse member)
    {
        if (busy || repo is null) return;
        busy = true;
        message = "";
        try
        {
            Report(await Api.DeleteAsync($"api/projects/{repo.Project.Id}/members/{member.UserId}", "Membership removed."));
            await LoadMembers(repo.Project.Id);
        }
        finally { busy = false; }
    }

    private void Report(ApiResult result)
    {
        message = result.Message;
        messageKind = result.Ok ? "success" : "error";
    }

    /// <summary>Returns null for anything that is not valid UTF-8 text, so binary blobs are never rendered.</summary>
    private static string? DecodeText(string content)
    {
        byte[] bytes = Convert.FromBase64String(content);
        if (bytes.Contains((byte)0)) return null;
        try { return new UTF8Encoding(false, true).GetString(bytes); }
        catch (DecoderFallbackException) { return null; }
    }

    private static string Initial(string value) => value.Length == 0 ? "?" : value[..1];
}
