@page "/{Namespace}/{Slug}"
@inject HttpClient Http

<PageTitle>Graft · @Slug</PageTitle>
@if (Loading) { <p role="status">Loading repository…</p> }
else if (Page is null) { <h1>Repository unavailable</h1><p>@Message</p> }
else
{
    <p class="eyebrow">@Page.Project.Namespace.Name / PRIVATE</p>
    <h1>@Page.Project.Name</h1><p class="intro">@Page.Project.Description</p>
    @if (Message.Length > 0) { <p role="status" class="message">@Message</p> }
    <div class="repository-grid">
        <section><h2>Files</h2>
            @if (Path.Length > 0) { <button class="link-button" @onclick="Up">← @Path</button> }
            @foreach (TreeEntryResponse entry in Page.Tree)
            {
                <button class="tree-entry" @onclick="() => Open(entry)"><span>@(entry.Type == "tree" ? "▣" : "□")</span><strong>@entry.Name</strong><small>@entry.Mode</small></button>
            }
        </section>
        <aside><section><h2>Branches</h2>@foreach (BranchResponse branch in Page.Branches) { <p><strong>@branch.Name</strong><br /><small>@branch.Commit.ShortId</small></p> }</section></aside>
    </div>
    @if (Page.File is not null)
    {
        <section class="file"><h2>@Page.File.FilePath</h2>
            @if (FileText is null) { <p>Binary file · @Page.File.Size bytes</p> }
            else { <pre>@FileText</pre> }
        </section>
    }
    <section><h2>Recent commits</h2>@foreach (CommitResponse commit in Page.Commits)
        { <article class="commit"><code>@commit.ShortId</code><span><strong>@commit.Title</strong><small>@commit.AuthorName · @commit.AuthoredDate.ToString("u")</small></span></article> }</section>
    @if (Page.CanManage)
    {
        <section>
            <h2>Project members</h2>
            <form class="create-project" @onsubmit="SetMember" @onsubmit:preventDefault>
                <label for="member-username">Username</label><input id="member-username" @bind="MemberUsername" required minlength="2" maxlength="39" />
                <label for="member-role">Role</label><select id="member-role" @bind="MemberRole"><option>Reporter</option><option>Developer</option><option>Maintainer</option></select>
                <button type="submit" disabled="@MemberBusy">@(MemberBusy ? "Saving…" : "Add or update member")</button>
            </form>
            @if (Members.Length == 0) { <p>No direct project members.</p> }
            @foreach (ProjectMemberResponse member in Members)
            {
                <div class="section-heading"><p><strong>@member.Username</strong> · @member.Role</p>
                    <button class="secondary" @onclick="() => RemoveMember(member)" disabled="@MemberBusy">Remove</button></div>
            }
        </section>
    }
}

@code {
    [Parameter] public string Namespace { get; set; } = "";
    [Parameter] public string Slug { get; set; } = "";
    private RepositoryPageResponse? Page;
    private SessionResponse? Session;
    private ProjectMemberResponse[] Members = [];
    private string Path = "";
    private string FilePath = "";
    private string? FileText;
    private string Message = "";
    private string MemberUsername = "";
    private string MemberRole = "Developer";
    private bool Loading = true;
    private bool MemberBusy;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            Session = await Http.GetFromJsonAsync("api/session", ApiJson.Default.SessionResponse);
            if (Session?.Authenticated != true) { Message = "Sign in from the projects page."; return; }
            ProjectResponse[] projects = await Http.GetFromJsonAsync("api/projects", ApiJson.Default.ProjectResponseArray) ?? [];
            ProjectResponse? project = projects.SingleOrDefault(item => item.PathWithNamespace == Namespace + "/" + Slug);
            if (project is null) { Message = "You do not have access to this project."; return; }
            await Load(project.Id);
        }
        catch (HttpRequestException) { Message = "Repository data could not be loaded."; }
        finally { Loading = false; }
    }

    private async Task Load(long id)
    {
        string query = $"api/browser/projects/{id}?ref=main&path={Uri.EscapeDataString(Path)}" +
            (FilePath.Length == 0 ? "" : "&file=" + Uri.EscapeDataString(FilePath));
        Page = await Http.GetFromJsonAsync(query, ApiJson.Default.RepositoryPageResponse);
        FileText = Page?.File is null ? null : DecodeText(Page.File.Content);
        if (Page?.CanManage == true) await LoadMembers(id);
    }

    private async Task Open(TreeEntryResponse entry)
    {
        if (entry.Type == "tree") { Path = entry.Path; FilePath = ""; }
        else { FilePath = entry.Path; }
        if (Page is not null) await Load(Page.Project.Id);
    }

    private async Task Up()
    {
        int separator = Path.LastIndexOf('/');
        Path = separator < 0 ? "" : Path[..separator];
        FilePath = "";
        if (Page is not null) await Load(Page.Project.Id);
    }

    private async Task LoadMembers(long projectId) => Members =
        await Http.GetFromJsonAsync($"api/projects/{projectId}/members", ApiJson.Default.ProjectMemberResponseArray) ?? [];

    private async Task SetMember()
    {
        if (MemberBusy || Page is null || Session is null) return;
        MemberBusy = true; Message = "";
        try
        {
            using HttpRequestMessage request = new(HttpMethod.Post, $"api/projects/{Page.Project.Id}/members");
            request.Headers.Add("X-Graft-CSRF", Session.Csrf);
            request.Content = JsonContent.Create(new MembershipSetRequest(MemberUsername, MemberRole), ApiJson.Default.MembershipSetRequest);
            using HttpResponseMessage response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode) { MemberUsername = ""; await LoadMembers(Page.Project.Id); Message = "Membership saved."; }
            else { ErrorResponse? error = await response.Content.ReadFromJsonAsync(ApiJson.Default.ErrorResponse); Message = error?.Message ?? "Membership update failed."; }
        }
        catch (HttpRequestException) { Message = "Membership update could not be confirmed."; }
        finally { MemberBusy = false; }
    }

    private async Task RemoveMember(ProjectMemberResponse member)
    {
        if (MemberBusy || Page is null || Session is null) return;
        MemberBusy = true; Message = "";
        try
        {
            using HttpRequestMessage request = new(HttpMethod.Delete, $"api/projects/{Page.Project.Id}/members/{member.UserId}");
            request.Headers.Add("X-Graft-CSRF", Session.Csrf);
            using HttpResponseMessage response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode) { await LoadMembers(Page.Project.Id); Message = "Membership removed."; }
            else Message = "Membership removal failed.";
        }
        catch (HttpRequestException) { Message = "Membership removal could not be confirmed."; }
        finally { MemberBusy = false; }
    }

    private static string? DecodeText(string content)
    {
        byte[] bytes = Convert.FromBase64String(content);
        if (bytes.Contains((byte)0)) return null;
        try { return new UTF8Encoding(false, true).GetString(bytes); }
        catch (DecoderFallbackException) { return null; }
    }
}
