<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData"><RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" /><FocusOnNavigate RouteData="routeData" Selector="h1" /></Found>
    <NotFound><LayoutView Layout="typeof(MainLayout)"><h1>Page not found</h1><p>The requested Graft page does not exist.</p></LayoutView></NotFound>
</Router>
