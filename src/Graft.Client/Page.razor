@page "/-/p/{Slug}"
@inject GraftApi Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* A published project page: the curated surface an owner chose to show, which is not the repository and
   never becomes it. It wears the repository's own layout, the masthead, the tabs, the file table and the
   readme beneath it, so a reader sees the project as it looks rather than a different product. What fills
   that layout came from the project's own .graft/project.json and nothing else: the file table holds the
   files the allowlist admits, the tabs are the surfaces the config opened, and there is no branch, clone,
   whole-repository download or diff anywhere on it, because a page cannot offer those (ADR 0045).

   A project that publishes a site of its own (site.root, on the pages origin) is sent there instead, since
   that is the page its owner designed. Any explicit ?tab= stays here, so the site can link back to the
   files, issues or releases. *@

<PageTitle>@(view?.Title ?? "Project page") &middot; Graft</PageTitle>

@if (loading)
{
    <p role="status" class="secondary-text">Loading…</p>
}
else if (view is null)
{
    <div class="page-header"><div><h1>Not found</h1><p class="subtitle">There is no published page at this address.</p></div></div>
    <Banner Message="@message" Kind="error" />
}
else
{
    @* The repository's masthead, markup for markup (ProjectHeader), so the banner, the avatar and the tabs sit
       where they sit on the project itself. The title is the page's, which names no account. *@
    <div class="project-masthead @(view.BannerUrl is null ? "" : "has-banner")">
        @if (view.BannerUrl is string banner)
        {
            <img class="project-banner" src="@banner" alt="" />
        }
        <div class="repo-header">
            <Avatar Url="@view.AvatarUrl" Name="@view.Title" Class="avatar-large" />
            <div>
                <h1>@view.Title</h1>
                <p class="subtitle">@(view.Description.Length > 0 ? view.Description : "No description")</p>
            </div>
            <span class="label accent">published page</span>
        </div>

        <nav class="tabs" aria-label="Project">
            @Tab("code", "Code")
            @if (view.History is not null) { @Tab("commits", "Commits") }
            @if (view.Issues) { @Tab("issues", "Issues") }
            @if (view.Releases) { @Tab("releases", "Releases") }
            @* Only what the config named and only what this reader may open: the server decided both. The
               destinations are the project's own pages, which apply their own rules again on arrival. *@
            @foreach (PageFeatureResponse feature in view.Features.Where(feature =>
                !(feature.Name == "issues" && view.Issues) && !(feature.Name == "releases" && view.Releases)))
            {
                <a href="@feature.Url">@FeatureLabel(feature.Name)</a>
            }
        </nav>
    </div>

    <Banner Message="@message" Kind="@messageKind" />

    @if (tab == "code")
    {
        <div class="panel overflowing">
            <div class="panel-header">
                <Icon Name="branch" />
                <span class="label accent">default branch</span>
                <span class="label">@FileCount @(FileCount == 1 ? "file" : "files")</span>
                <span class="spacer"></span>
                @if (view.SiteUrl is { Length: > 0 })
                {
                    @* Leaves this origin by design: a project's site is served from a hostname of its own. *@
                    <a class="button primary" href="@view.SiteUrl" rel="noopener noreferrer">
                        <Icon Name="repository" />Open the site
                    </a>
                }
            </div>
        </div>

        <nav class="row" aria-label="Path">
            <button type="button" class="link" @onclick="() => Navigate(string.Empty)">@view.Title</button>
            @foreach ((string label, string target) in Crumbs())
            {
                <span class="muted">/</span>
                <button type="button" class="link" @onclick="() => Navigate(target)">@label</button>
            }
        </nav>

        List<Entry> entries = Entries();
        <div class="file-table">
            <div class="file-table-header">
                <Icon Name="file" />
                <span>@entries.Count @(entries.Count == 1 ? "entry" : "entries")</span>
            </div>
            @if (path.Length > 0)
            {
                <button type="button" class="file-row" @onclick="Up">
                    <Icon Name="chevron-left" />
                    <span class="name">..</span>
                    <span class="meta">parent directory</span>
                </button>
            }
            @foreach (Entry entry in entries)
            {
                @if (entry.Directory || entry.Readable)
                {
                    <button type="button" class="file-row @(entry.Directory ? "tree" : "blob")" @onclick="() => Open(entry)">
                        <Icon Name="@(entry.Directory ? "folder" : "file")" />
                        <span class="name">@entry.Name</span>
                        <span class="meta"></span>
                    </button>
                }
                else
                {
                    @* Named by the structure listing, not offered by the allowlist: the name is all there is. *@
                    <div class="file-row blob closed">
                        <Icon Name="file" />
                        <span class="name">@entry.Name</span>
                        <span class="meta">name only</span>
                    </div>
                }
            }
            @if (entries.Count == 0)
            {
                <p class="panel-empty">@(path.Length == 0 ? "This page offers no files." : "This directory is empty.")</p>
            }
        </div>

        @if (view.Readme is not null && openPath is null && path.Length == 0)
        {
            <div class="panel readme">
                <div class="panel-header"><Icon Name="file" /><strong>@view.Readme.Path</strong></div>
                @* The HTML comes from the server's renderer, under the README's rules; its pictures point at the
                   page's own image route and only at files the allowlist admits. *@
                <div class="panel-body markdown">@((MarkupString)view.Readme.Html)</div>
            </div>
        }

        @if (openPath is not null)
        {
            <div class="panel blob-view">
                <div class="panel-header">
                    <Icon Name="file" />
                    <strong class="mono">@openPath</strong>
                    <span class="spacer"></span>
                    @if (openText is not null)
                    {
                        <span class="label">@System.Text.Encoding.UTF8.GetByteCount(openText) bytes</span>
                    }
                    @if (openMarkdown is not null)
                    {
                        <button type="button" class="secondary" aria-pressed="@(showSource ? "true" : "false")" @onclick="() => showSource = !showSource">
                            @(showSource ? "Rendered" : "Source")
                        </button>
                    }
                    @if (openImage || openText is not null)
                    {
                        <a class="button secondary" href="@(openImage ? ImageUrl(openPath) : FileUrl(openPath))" download="@FileName(openPath)">
                            <Icon Name="download" />Download
                        </a>
                    }
                    <button type="button" class="secondary" @onclick="() => Go(path, null)">Close</button>
                </div>
                @if (openImage)
                {
                    <img class="blob-image" src="@ImageUrl(openPath)" alt="@openPath" />
                }
                else if (openMarkdown is not null && !showSource)
                {
                    @* The server's renderer, under the readme's rules and the page's allowlist. *@
                    <div class="panel-body markdown">@((MarkupString)openMarkdown.Html)</div>
                }
                else if (openText is null)
                {
                    <p class="panel-empty">Binary file. Graft does not render its contents.</p>
                }
                else
                {
                    <pre>@openText</pre>
                }
            </div>
        }
    }
    else if (tab == "commits" && view.History is not null)
    {
        @* What was said and when. Not what changed: there is no diff behind these rows and no link to one. *@
        <div class="panel">
            <div class="panel-header"><h2>Recent commits</h2><span class="spacer"></span>
                <span class="label">@view.History.Commits.Count</span></div>
            <div class="list">
                @foreach (PageCommitResponse commit in view.History.Commits)
                {
                    <div class="commit-row">
                        <code class="sha">@commit.ShortId</code>
                        <span class="list-item-main">
                            <strong>@commit.Title</strong>
                            <small>
                                @if (commit.AuthorName is { Length: > 0 }) { <span>@commit.AuthorName</span> }
                                @if (commit.AuthorEmail is { Length: > 0 }) { <span> &lt;@commit.AuthorEmail&gt;</span> }
                                @if (commit.AuthorName is { Length: > 0 }) { <span> &middot; </span> }
                                @commit.CommittedAt.ToString("u")
                            </small>
                            @if (openCommit == commit.Id && HasBody(commit))
                            {
                                <pre class="commit-message">@commit.Message.Trim()</pre>
                            }
                        </span>
                        @if (HasBody(commit))
                        {
                            <button type="button" class="link" @onclick="() => openCommit = openCommit == commit.Id ? null : commit.Id">
                                @(openCommit == commit.Id ? "Less" : "More")
                            </button>
                        }
                    </div>
                }
            </div>
            @if (view.History.Commits.Count == 0) { <p class="panel-empty">No commits yet.</p> }
            <div class="panel-body">
                <p class="secondary-text">
                    The @(view.History.Commits.Count == 1 ? "most recent commit" : view.History.Commits.Count + " most recent commits") on the default branch.
                    @(view.History.Authors == "none" ? "Authors are not shown." : "")
                </p>
            </div>
        </div>
    }
    else if (tab == "releases" && view.Releases)
    {
        <div class="panel">
            <div class="panel-header"><Icon Name="archive" /><h2>Releases</h2><span class="spacer"></span>
                @if (releases is not null) { <span class="label">@releases.Length</span> }</div>
            @if (releases is null)
            {
                <div class="panel-empty">Loading…</div>
            }
            else if (releases.Length == 0)
            {
                <div class="panel-empty">Nothing has been released.</div>
            }
            else
            {
                @foreach (PageReleaseResponse release in releases)
                {
                    <div class="panel-body">
                        <h3>@release.Name</h3>
                        <p class="secondary-text"><code>@release.TagName</code> &middot; released @release.ReleasedAt.ToLocalTime().ToString("yyyy-MM-dd") by @release.Author</p>
                        @if (release.Description.Length > 0) { <pre class="commit-message">@release.Description</pre> }
                        @if (release.Files.Count > 0 || release.Links.Count > 0)
                        {
                            <div class="list">
                                @foreach (ReleaseFileResponse file in release.Files)
                                {
                                    <div class="list-item">
                                        <Icon Name="download" />
                                        <span class="list-item-main">
                                            <strong><a href="@file.Url" download>@file.FileName</a></strong>
                                            <small>@file.Size bytes &middot; sha256 <code>@file.Sha256[..12]</code></small>
                                        </span>
                                    </div>
                                }
                                @foreach (ReleaseLinkResponse link in release.Links)
                                {
                                    <div class="list-item">
                                        <Icon Name="chevron-right" />
                                        <span class="list-item-main">
                                            @* Leaves this origin: a release link is an address the project wrote. *@
                                            <strong><a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Name</a></strong>
                                            <small>@link.LinkType</small>
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
    else if (tab == "issues" && view.Issues)
    {
        @if (openIssue is not null)
        {
            <div class="panel">
                <div class="panel-header">
                    <Icon Name="issue" Class="@(openIssue.Issue.State == "closed" ? "icon muted" : "icon")" />
                    <h2>@openIssue.Issue.Title</h2>
                    <span class="spacer"></span>
                    <span class="label @(openIssue.Issue.State == "closed" ? "" : "accent")">@(openIssue.Issue.State == "closed" ? "closed" : "open")</span>
                    <button type="button" class="secondary" @onclick="() => openIssue = null">Back to issues</button>
                </div>
                <div class="panel-body">
                    <p class="secondary-text">
                        #@openIssue.Issue.Iid opened by @openIssue.Issue.Author.Username on @openIssue.Issue.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                        @if (openIssue.Issue.ClosedAt is DateTimeOffset closed) { <span> &middot; closed @closed.ToLocalTime().ToString("yyyy-MM-dd")</span> }
                        @if (openIssue.Issue.Milestone is not null) { <span> &middot; @openIssue.Issue.Milestone.Title</span> }
                    </p>
                    @if (openIssue.Issue.LabelDetails is { Count: > 0 })
                    {
                        <span class="list-labels">
                            @foreach (LabelResponse label in openIssue.Issue.LabelDetails) { <LabelChip Label="label" /> }
                        </span>
                    }
                    @if (openIssue.Issue.Description.Length > 0) { <pre class="commit-message">@openIssue.Issue.Description</pre> }
                    else { <p class="secondary-text">No description.</p> }
                </div>
                <div class="panel-header"><h3>Comments</h3><span class="spacer"></span><span class="label">@openIssue.Notes.Count</span></div>
                @if (openIssue.Notes.Count == 0)
                {
                    <div class="panel-empty">No comments.</div>
                }
                else
                {
                    <div class="list">
                        @foreach (NoteResponse note in openIssue.Notes)
                        {
                            <div class="list-item">
                                <Icon Name="user" />
                                <span class="list-item-main">
                                    <small>@note.Author.Username &middot; @note.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(note.EditedAt is null ? "" : " · edited")</small>
                                    <pre class="commit-message">@note.Body</pre>
                                </span>
                            </div>
                        }
                    </div>
                }
                <div class="panel-body">
                    <p class="secondary-text">Read only. Commenting needs an account on this project.</p>
                </div>
            </div>
        }
        else
        {
            <div class="panel">
                <div class="panel-header"><Icon Name="issue" /><h2>Issues</h2><span class="spacer"></span>
                    @if (issues is not null) { <span class="label">@issueTotal</span> }</div>
                <div class="panel-body">
                    <div class="tabs">
                        <button type="button" class="@(issueState == "opened" ? "active" : "")" @onclick='() => FilterIssues("opened")'>Open</button>
                        <button type="button" class="@(issueState == "closed" ? "active" : "")" @onclick='() => FilterIssues("closed")'>Closed</button>
                        <button type="button" class="@(issueState == "all" ? "active" : "")" @onclick='() => FilterIssues("all")'>All</button>
                    </div>
                </div>
                @if (issues is null)
                {
                    <div class="panel-empty">Loading…</div>
                }
                else if (issues.Length == 0)
                {
                    <div class="panel-empty">
                        @(issueState == "opened" ? "Nothing is open." : issueState == "closed" ? "Nothing has been closed." : "No issues yet.")
                    </div>
                }
                else
                {
                    <div class="list">
                        @foreach (IssueResponse issue in issues)
                        {
                            <button type="button" class="list-item file-row" @onclick="() => OpenIssue(issue.Iid)">
                                <Icon Name="issue" Class="@(issue.State == "closed" ? "icon muted" : "icon")" />
                                <span class="list-item-main">
                                    <strong>@issue.Title</strong>
                                    <small>
                                        #@issue.Iid opened by @issue.Author.Username
                                        @if (issue.UserNotesCount > 0)
                                        {
                                            <span> &middot; @issue.UserNotesCount @(issue.UserNotesCount == 1 ? "comment" : "comments")</span>
                                        }
                                        @if (issue.Milestone is not null) { <span> &middot; @issue.Milestone.Title</span> }
                                    </small>
                                    @if (issue.LabelDetails is { Count: > 0 })
                                    {
                                        <span class="list-labels">
                                            @foreach (LabelResponse label in issue.LabelDetails) { <LabelChip Label="label" /> }
                                        </span>
                                    }
                                </span>
                                <Icon Name="chevron-right" />
                            </button>
                        }
                    </div>
                    @if (issueTotal > issues.Length)
                    {
                        <div class="panel-body">
                            <p class="secondary-text">Showing the newest @issues.Length of @issueTotal.</p>
                        </div>
                    }
                }
            </div>
        }
    }

    <p class="secondary-text">This repo is semi-public, not all source is available.</p>
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    /// <summary>The surface a link asked for. Present at all, it also keeps a reader here rather than on the
    /// project's own site, which is how that site links back.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    /// <summary>The file a link asked for, which a rendered document uses to link to another. Like ?tab=, it
    /// also keeps a reader here rather than on the project's own site.</summary>
    [SupplyParameterFromQuery(Name = "file")] public string? FileQuery { get; set; }
    [SupplyParameterFromQuery(Name = "path")] public string? PathQuery { get; set; }
    private string? appliedLocation;

    /// <summary>One row of the file table: a directory, or a file the page offers or only names.</summary>
    private sealed record Entry(string Name, string Path, bool Directory, bool Readable);

    private ProjectPageResponse? view;
    private string tab = "code";
    private string path = "";
    private string? openPath;
    private string? openText;
    private ReadmeResponse? openMarkdown;
    private bool showSource;
    private bool openImage;
    private string? openCommit;
    private PageReleaseResponse[]? releases;
    private IssueResponse[]? issues;
    private long issueTotal;
    private string issueState = "opened";
    private PageIssueResponse? openIssue;
    private string message = "";
    private string messageKind = "info";
    private bool loading = true;
    private string? loadedSlug;

    // The formats the page's image route serves. Anything else opens as text or as "binary".
    private static readonly string[] ImageExtensions = [".png", ".gif", ".jpg", ".jpeg", ".webp"];

    private string PageApi => $"api/graft/pages/{Uri.EscapeDataString(Slug)}";

    private int FileCount => view?.Tree is { } tree ? tree.Count(entry => entry.Type == "blob" && entry.Readable) : view?.Files.Count ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        // A change of ?tab= alone is a change of surface, not of page: nothing is fetched again.
        if (loadedSlug == Slug && view is not null)
        {
            await SelectTab(TabQuery ?? "code");
            await ApplyLocation();
            return;
        }

        loading = true;
        loadedSlug = Slug;
        path = "";
        appliedLocation = null;
        CloseFile();
        openIssue = null;
        issues = null;
        releases = null;
        try
        {
            // Deliberately not requiring a session. A published page is for readers who have no account,
            // which is the entire reason the surface exists.
            (bool reached, ProjectPageResponse? loaded) = await Api.GetOptionalAsync(PageApi, ApiJson.Default.ProjectPageResponse);
            if (!reached) { message = "Graft could not be reached."; messageKind = "error"; return; }
            view = loaded;
            if (view is null) { message = "No page is published at this address, or it was withdrawn."; return; }

            // The owner designed a site; that is the page. Replacing the entry keeps Back from bouncing here.
            if (view.SiteUrl is { Length: > 0 } site && TabQuery is null && FileQuery is null && PathQuery is null)
            {
                Navigation.NavigateTo(site, forceLoad: true, replace: true);
                return;
            }
        }
        finally { loading = false; }

        await SelectTab(TabQuery ?? "code");
        await ApplyLocation();
    }

    /// <summary>Renders mermaid diagrams in the readme or an open document once it is in the DOM, as the project page does.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (tab != "code") return;
        bool readmeShown = view?.Readme?.HasDiagrams == true && openPath is null && path.Length == 0;
        bool documentShown = openMarkdown?.HasDiagrams == true && !showSource;
        if (!readmeShown && !documentShown) return;
        try { await JS.InvokeVoidAsync("graftMarkdown.render"); }
        catch (JSException) { }
    }

    /// <summary>Opens the folder or file the address names, once per distinct address.</summary>
    private async Task ApplyLocation()
    {
        string location = (PathQuery ?? "") + "\n" + (FileQuery ?? "");
        if (location == appliedLocation) return;
        appliedLocation = location;
        CloseFile();
        message = "";
        if (FileQuery is { Length: > 0 } file)
        {
            tab = "code";
            path = file.LastIndexOf('/') is var slash and > 0 ? file[..slash] : "";
            await OpenFile(file);
        }
        else path = PathQuery ?? "";
    }

    /// <summary>Moves to a folder or file by address, so Back returns here and a document can link to another.</summary>
    private void Go(string newPath, string? newFile)
    {
        string query = newFile is { Length: > 0 } ? "?file=" + QueryPath(newFile)
            : newPath.Length > 0 ? "?path=" + QueryPath(newPath)
            : "";
        Navigation.NavigateTo("/-/p/" + Uri.EscapeDataString(Slug) + query);
    }

    private static string QueryPath(string value) => string.Join('/', value.Split('/').Select(Uri.EscapeDataString));

    private RenderFragment Tab(string key, string label) =>
        @<button type="button" class="@(tab == key ? "active" : "")" aria-current="@(tab == key ? "page" : null)" @onclick="() => SelectTab(key)">@label</button>;

    /// <summary>Opens a surface the page offers. Anything it does not offer is the file table, which every page has.</summary>
    private async Task SelectTab(string chosen)
    {
        tab = chosen switch
        {
            "commits" when view?.History is not null => "commits",
            "issues" when view?.Issues == true => "issues",
            "releases" when view?.Releases == true => "releases",
            _ => "code"
        };
        // The two surfaces with routes of their own are fetched when first opened, so a page with many issues
        // is not held up by them and a refused one simply stays empty.
        if (tab == "releases" && releases is null)
        {
            (bool reached, PageReleaseResponse[]? loaded) = await Api.GetOptionalAsync(PageApi + "/releases", ApiJson.Default.PageReleaseResponseArray);
            releases = reached ? loaded ?? [] : [];
        }
        if (tab == "issues" && issues is null) await LoadIssues();
    }

    /// <summary>
    /// The rows of one directory, from the listing the server already filtered. With the structure published it
    /// is the tree, where a file may be named but not offered; without it, the folders are only the ones the
    /// offered files sit in, so a folder never appears that holds nothing a reader can open.
    /// </summary>
    private List<Entry> Entries()
    {
        if (view is null) return [];
        string prefix = path.Length == 0 ? "" : path + "/";
        Dictionary<string, Entry> rows = new(StringComparer.Ordinal);
        if (view.Tree is not null)
        {
            foreach (PageTreeEntryResponse item in view.Tree)
            {
                if (!item.Path.StartsWith(prefix, StringComparison.Ordinal)) continue;
                string rest = item.Path[prefix.Length..];
                if (rest.Length == 0 || rest.Contains('/')) continue;
                rows[rest] = new(rest, item.Path, item.Type == "tree", item.Readable);
            }
        }
        else
        {
            foreach (string file in view.Files)
            {
                if (!file.StartsWith(prefix, StringComparison.Ordinal)) continue;
                string rest = file[prefix.Length..];
                int slash = rest.IndexOf('/');
                if (slash < 0) rows[rest] = new(rest, file, false, true);
                else rows.TryAdd(rest[..slash], new(rest[..slash], prefix + rest[..slash], true, true));
            }
        }
        // Directories before files, then by name, as the project page orders a tree.
        return [.. rows.Values.OrderByDescending(entry => entry.Directory).ThenBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase)];
    }

    private void Open(Entry entry)
    {
        if (entry.Directory) Go(entry.Path, null);
        else Go(path, entry.Path);
    }

    private async Task OpenFile(string file)
    {
        bool offered = view?.Tree is { } tree
            ? tree.Any(item => item.Path == file && item.Type == "blob" && item.Readable)
            : view?.Files.Contains(file) == true;
        if (!offered) { message = "This page does not offer " + file + "."; messageKind = "error"; return; }
        if (IsImage(file))
        {
            openPath = file;
            openImage = true;
            return;
        }
        (bool reached, string? text) = await Api.GetTextAsync(PageApi + "/files/" + Uri.EscapeDataString(file));
        if (!reached) { message = "Graft could not be reached."; messageKind = "error"; return; }
        if (IsMarkdown(file) && text is not null)
            (_, openMarkdown) = await Api.GetOptionalAsync(PageApi + "/markdown/" + Uri.EscapeDataString(file), ApiJson.Default.ReadmeResponse);
        openPath = file;
        openText = text;
    }

    private void Navigate(string target) => Go(target, null);

    private void Up()
    {
        int separator = path.LastIndexOf('/');
        Navigate(separator < 0 ? "" : path[..separator]);
    }

    private void CloseFile()
    {
        openPath = null;
        openText = null;
        openMarkdown = null;
        showSource = false;
        openImage = false;
    }

    /// <summary>Breadcrumb segments with the path each one navigates to.</summary>
    private IEnumerable<(string Label, string Target)> Crumbs()
    {
        if (path.Length == 0) yield break;
        string[] segments = path.Split('/');
        for (int index = 0; index < segments.Length; index++)
            yield return (segments[index], string.Join('/', segments[..(index + 1)]));
    }

    private string FileUrl(string file) => "/" + PageApi + "/files/" + Uri.EscapeDataString(file);
    private string ImageUrl(string file) => "/" + PageApi + "/image?path=" + Uri.EscapeDataString(file);
    private static string FileName(string file) => file[(file.LastIndexOf('/') + 1)..];
    private static bool IsImage(string file) => ImageExtensions.Any(extension => file.EndsWith(extension, StringComparison.OrdinalIgnoreCase));
    private static bool IsMarkdown(string file) =>
        file.EndsWith(".md", StringComparison.OrdinalIgnoreCase) || file.EndsWith(".markdown", StringComparison.OrdinalIgnoreCase);

    private async Task LoadIssues()
    {
        (bool reached, IssuePageResponse? loaded) = await Api.GetOptionalAsync(
            PageApi + "/issues?state=" + issueState + "&per_page=50", ApiJson.Default.IssuePageResponse);
        issues = reached && loaded is not null ? [.. loaded.Issues] : [];
        issueTotal = loaded?.Total ?? 0;
    }

    private async Task FilterIssues(string state)
    {
        issueState = state;
        issues = null;
        await LoadIssues();
    }

    private async Task OpenIssue(long iid)
    {
        message = "";
        (bool reached, PageIssueResponse? loaded) = await Api.GetOptionalAsync(
            PageApi + "/issues/" + iid.ToString(System.Globalization.CultureInfo.InvariantCulture), ApiJson.Default.PageIssueResponse);
        if (!reached) { message = "Graft could not be reached."; messageKind = "error"; return; }
        if (loaded is null) { message = $"Issue #{iid} could not be shown."; messageKind = "error"; return; }
        openIssue = loaded;
    }

    /// <summary>Whether a commit said more than its first line.</summary>
    private static bool HasBody(PageCommitResponse commit) => commit.Message.Trim().Length > commit.Title.Trim().Length;

    /// <summary>The config names features by GitLab's snake-case names; a reader is shown words.</summary>
    private static string FeatureLabel(string name) => name switch
    {
        "issues" => "Issues",
        "merge_requests" => "Merge requests",
        "boards" => "Boards",
        "milestones" => "Milestones",
        "wiki" => "Wiki",
        "releases" => "Releases",
        "snippets" => "Snippets",
        _ => name
    };
}
