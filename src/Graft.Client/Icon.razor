@* Graft's icon set. Hand-authored 16x16 stroke geometry so there is no vendored icon font, no external
   request and no third-party licence to track. Icons inherit colour from their container. *@

<svg class="@Class" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "folder":
            <path d="M1.5 12.75v-9.5h4.4l1.5 1.75h7.1v7.75a.5.5 0 0 1-.5.5h-12a.5.5 0 0 1-.5-.5z" />
            break;
        case "file":
            <path d="M4 1.75h5.25l2.75 2.75v9.75H4z" />
            <path d="M9.25 1.75v2.75h2.75" />
            break;
        case "branch":
            <circle cx="4.25" cy="3.5" r="1.75" />
            <circle cx="4.25" cy="12.5" r="1.75" />
            <circle cx="11.75" cy="3.5" r="1.75" />
            <path d="M4.25 5.25v5.5M11.75 5.25v1.5a2.5 2.5 0 0 1-2.5 2.5H6.75a2.5 2.5 0 0 0-2.5 2.25" />
            break;
        case "commit":
            <circle cx="8" cy="8" r="2.5" />
            <path d="M0.75 8h4.75M10.5 8h4.75" />
            break;
        case "upload":
            <path d="M8 10.75V2.25M4.75 5.5 8 2.25l3.25 3.25" />
            <path d="M1.75 10.25v3a.5.5 0 0 0 .5.5h11.5a.5.5 0 0 0 .5-.5v-3" />
            break;
        case "download":
            <path d="M8 2.25v8.5M4.75 7.5 8 10.75l3.25-3.25" />
            <path d="M1.75 10.25v3a.5.5 0 0 0 .5.5h11.5a.5.5 0 0 0 .5-.5v-3" />
            break;
        case "user":
            <circle cx="8" cy="5" r="2.75" />
            <path d="M2.75 14.25c0-2.9 2.35-4.5 5.25-4.5s5.25 1.6 5.25 4.5" />
            break;
        case "shield":
            <path d="M8 1.75l5.5 1.9v3.6c0 3.4-2.3 5.8-5.5 7-3.2-1.2-5.5-3.6-5.5-7V3.65z" />
            break;
        case "key":
            <circle cx="5" cy="11" r="2.5" />
            <path d="M6.9 9.1 13.25 2.75M11 5l1.75 1.75" />
            break;
        case "lock":
            <path d="M4.75 7.25V5.5a3.25 3.25 0 0 1 6.5 0v1.75" />
            <rect x="2.75" y="7.25" width="10.5" height="6.5" rx=".75" />
            break;
        case "archive":
            <rect x="1.75" y="2.75" width="12.5" height="3" rx=".75" />
            <path d="M2.75 5.75v7.5a.5.5 0 0 0 .5.5h9.5a.5.5 0 0 0 .5-.5v-7.5M6.25 9h3.5" />
            break;
        case "plus":
            <path d="M8 3.25v9.5M3.25 8h9.5" />
            break;
        case "copy":
            <rect x="5.75" y="5.75" width="8.5" height="8.5" rx=".75" />
            <path d="M10.25 5.75v-3a.75.75 0 0 0-.75-.75h-7a.75.75 0 0 0-.75.75v7a.75.75 0 0 0 .75.75h3" />
            break;
        case "chevron-left":
            <path d="M10 3 5 8l5 5" />
            break;
        case "chevron-right":
            <path d="M6 3l5 5-5 5" />
            break;
        case "sun":
            <circle cx="8" cy="8" r="3.25" />
            <path d="M8 .75v1.5M8 13.75v1.5M.75 8h1.5M13.75 8h1.5M2.9 2.9l1.05 1.05M12.05 12.05l1.05 1.05M13.1 2.9l-1.05 1.05M3.95 12.05 2.9 13.1" />
            break;
        case "moon":
            <path d="M13.25 10.4A6.25 6.25 0 0 1 5.6 2.75a6.25 6.25 0 1 0 7.65 7.65z" />
            break;
        case "search":
            <circle cx="7" cy="7" r="4.25" />
            <path d="M10.25 10.25 14 14" />
            break;
        case "settings":
            <path d="M2 4.5h12M2 8h12M2 11.5h12" />
            <circle cx="6" cy="4.5" r="1.5" fill="currentColor" stroke="none" />
            <circle cx="10.5" cy="8" r="1.5" fill="currentColor" stroke="none" />
            <circle cx="5.25" cy="11.5" r="1.5" fill="currentColor" stroke="none" />
            break;
        case "check":
            <path d="M3 8.5 6.25 11.75 13 5" />
            break;
        case "close":
            <path d="M4 4l8 8M12 4l-8 8" />
            break;
        case "alert":
            <path d="M8 2.25 15 13.75H1z" />
            <path d="M8 6.5v3M8 11.75v.01" />
            break;
        case "repository":
            <path d="M2.75 2.75h7.5l3 3v7.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5z" />
            <path d="M5.25 6.25h5.5M5.25 9h3.5" />
            break;
        default:
            <circle cx="8" cy="8" r="5.5" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Class { get; set; } = "icon";
}
