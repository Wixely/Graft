@page "/-/login"
@inject GraftApi Api
@inject NavigationManager Navigation

<PageTitle>Sign in &middot; Graft</PageTitle>

<div class="sign-in">
    <div class="sign-in-mark">
        <img src="graft-app-blue.png" alt="" width="36" height="36" />
        <h1>Sign in to Graft</h1>
    </div>

    @if (message.Length > 0) { <Banner Message="@message" Kind="error" /> }
    else if (Notice == "password") { <Banner Message="Password changed. Sign in again." Kind="success" /> }
    else if (Notice == "signed-out") { <Banner Message="You were signed out." Kind="info" /> }
    else if (Notice == "reset") { <Banner Message="Password set. Sign in with it." Kind="success" /> }

    <div class="panel">
        <div class="panel-body">
            @if (challenge is not null)
            {
                @* The password was accepted; the account signs in with an authenticator app as well. The
                   challenge is spent by one attempt, right or wrong, so a wrong code starts again. *@
                <form class="form" @onsubmit="Complete" @onsubmit:preventDefault>
                    <label for="code">Code from your authenticator app, or a recovery code</label>
                    <input id="code" autocomplete="one-time-code" inputmode="numeric" @bind="code" required maxlength="32" @ref="codeField" />
                    <div class="form-actions">
                        <button type="submit" disabled="@busy">@(busy ? "Signing in…" : "Sign in")</button>
                        <button type="button" class="secondary" @onclick="StartOver" disabled="@busy">Start over</button>
                    </div>
                </form>
            }
            else
            {
            <form class="form" @onsubmit="SignIn" @onsubmit:preventDefault>
                <label for="username">Username</label>
                <input id="username" autocomplete="username" @bind="username" required maxlength="39" @ref="usernameField" />
                <label for="password">Password</label>
                @* No minlength here. This field submits an existing credential, so the creation policy is not
                   its business, and the server is the authority on whether it is accepted. The create, change
                   and reset forms still state the 16-character minimum, because there it is a real rule. *@
                <input id="password" type="password" autocomplete="current-password" @bind="password" required maxlength="256" @ref="passwordField" />
                <div class="form-actions">
                    <button type="submit" disabled="@busy">@(busy ? "Signing in…" : "Sign in")</button>
                </div>
            </form>
            <p class="secondary-text"><a href="/-/forgot">Forgot your password?</a></p>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Set when another page sent the browser here after ending the session.</summary>
    [SupplyParameterFromQuery(Name = "notice")] public string? Notice { get; set; }

    private ElementReference usernameField;
    private ElementReference passwordField;
    private string username = "";
    private string password = "";
    private string message = "";
    private bool busy;

    /// <summary>
    /// Set when a sign-in was refused. The submit button disables itself while the request is in flight, and
    /// a browser moves focus to the document body when the focused element becomes disabled, so without this
    /// a failed attempt leaves the caret nowhere at all and the reader has to go looking for the form again.
    /// The refusal itself is announced by the banner's live region, which needs no focus of its own.
    /// </summary>
    private bool refocus;

    protected override async Task OnInitializedAsync()
    {
        if (await Api.EnsureSessionAsync()) Navigation.NavigateTo("/", replace: true);
    }

    /// <summary>
    /// Puts the caret where the next keystroke should go: the username box when the page first appears, and
    /// the password box after a refusal.
    ///
    /// <para>
    /// The HTML <c>autofocus</c> attribute would not do the first of those. This is a single-page
    /// application, so arriving here is usually a client-side route change rather than a document load, and
    /// a browser applies autofocus only on the latter. Left alone, focus stays wherever the previous page
    /// put it, which is whichever link was clicked to get here.
    /// </para>
    ///
    /// <para>
    /// It never moves focus on an ordinary re-render, only on those two events, so typing into one field is
    /// never interrupted by the caret jumping to the other.
    /// </para>
    /// </summary>
    private async Task FocusAsync(bool firstRender)
    {
        if (!firstRender && !refocus) return;
        // A signed-in visitor is redirected away by OnInitializedAsync, and the element is gone by the time
        // this runs. That is an ordinary race rather than a fault, so it is not worth reporting.
        try
        {
            if (firstRender) await usernameField.FocusAsync();
            else if (refocus) { refocus = false; await passwordField.FocusAsync(); }
        }
        catch (Microsoft.JSInterop.JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task SignIn()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            SignInOutcome outcome = await Api.SignInAsync(username, password);
            password = "";
            if (outcome.Ok) { Navigation.NavigateTo("/", replace: true); return; }
            if (outcome.Challenge is not null) { challenge = outcome.Challenge; focusCode = true; return; }
            message = outcome.Message;
            refocus = true;
        }
        finally { busy = false; }
    }

    /// <summary>The second step, when the account signs in with an authenticator app as well.</summary>
    private string? challenge;
    private string code = "";
    private ElementReference codeField;
    private bool focusCode;

    private async Task Complete()
    {
        if (busy || challenge is null) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.CompleteSignInAsync(challenge, code.Trim());
            code = "";
            if (result.Ok) { Navigation.NavigateTo("/", replace: true); return; }
            // The challenge is spent by the attempt; the password step comes round again.
            challenge = null;
            message = result.Message;
            refocus = true;
        }
        finally { busy = false; }
    }

    private void StartOver()
    {
        challenge = null;
        code = "";
        message = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusCode)
        {
            focusCode = false;
            try { await codeField.FocusAsync(); }
            catch (Microsoft.JSInterop.JSException) { }
            catch (InvalidOperationException) { }
            return;
        }
        await FocusAsync(firstRender);
    }
}
