@page "/-/login"
@inject GraftApi Api
@inject NavigationManager Navigation

<PageTitle>Sign in &middot; Graft</PageTitle>

<div class="page-header"><div><h1>Sign in to Graft</h1><p class="subtitle">Use your local Graft account.</p></div></div>

@if (message.Length > 0) { <Banner Message="@message" Kind="error" /> }
else if (Notice == "password") { <Banner Message="Password changed. Sign in again." Kind="success" /> }
else if (Notice == "signed-out") { <Banner Message="You were signed out." Kind="info" /> }

<div class="panel">
    <div class="panel-body">
        <form class="form" @onsubmit="SignIn" @onsubmit:preventDefault>
            <label for="username">Username</label>
            <input id="username" autocomplete="username" @bind="username" required maxlength="39" />
            <label for="password">Password</label>
            @* No minlength here. This field submits an existing credential, so the creation policy is not
               its business, and the server is the authority on whether it is accepted. The create, change
               and reset forms still state the 16-character minimum, because there it is a real rule. *@
            <input id="password" type="password" autocomplete="current-password" @bind="password" required maxlength="256" />
            <div class="form-actions">
                <button type="submit" disabled="@busy">@(busy ? "Signing in…" : "Sign in")</button>
            </div>
        </form>
    </div>
</div>

@code {
    /// <summary>Set when another page sent the browser here after ending the session.</summary>
    [SupplyParameterFromQuery(Name = "notice")] public string? Notice { get; set; }

    private string username = "";
    private string password = "";
    private string message = "";
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (await Api.EnsureSessionAsync()) Navigation.NavigateTo("/", replace: true);
    }

    private async Task SignIn()
    {
        if (busy) return;
        busy = true;
        message = "";
        try
        {
            ApiResult result = await Api.LoginAsync(username, password);
            password = "";
            if (result.Ok) Navigation.NavigateTo("/", replace: true);
            else message = result.Message;
        }
        finally { busy = false; }
    }
}
