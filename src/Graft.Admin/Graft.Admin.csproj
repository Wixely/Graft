<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishAot Condition="'$(GraftAdminAot)' == 'true'">true</PublishAot>
    <RestorePackagesWithLockFile Condition="'$(RuntimeIdentifier)' == ''">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(BaseIntermediateOutputPath)packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GraftAdminStatic)' == 'true'">
    <PublishAot>true</PublishAot>
    <StaticExecutable>true</StaticExecutable>
    <StaticOpenSslLinking>true</StaticOpenSslLinking>
    <StaticICULinking>true</StaticICULinking>
    <EmbedIcuDataPath>/usr/share/icu/74.2/icudt74l.dat</EmbedIcuDataPath>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>
  <!-- SQLite linked into the executable, so it is one file: GraftSqliteLibrary names the static library eng/build-sqlite.ps1
       or eng/build-sqlite.sh built from eng/sqlite.txt, the same SQLite with the same options as the e_sqlite3 a managed
       build loads. A static Linux build without one falls back to the system libsqlite3, whose defaults differ. -->
  <PropertyGroup Condition="'$(GraftAdminStatic)' == 'true' and '$(GraftSqliteLibrary)' == ''">
    <GraftSqliteLibrary>/usr/lib/libsqlite3.a</GraftSqliteLibrary>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(GraftSqliteLibrary)' != ''">
    <DirectPInvoke Include="e_sqlite3" />
    <NativeLibrary Include="$(GraftSqliteLibrary)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Graft.Operations/Graft.Operations.csproj" />
    <ProjectReference Include="../Graft.Storage/Graft.Storage.csproj" />
  </ItemGroup>
</Project>
