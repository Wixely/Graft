<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>graft-runner</AssemblyName>
    <RootNamespace>Graft.Runner</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(GraftRunnerAot)' == 'true'">true</PublishAot>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!-- Pinned with the forge's: the SDK's own NativeAOT compiler can carry a NuGet advisory (NU1903), which fails restore. -->
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">10.0.14</RuntimeFrameworkVersion>
    <RestorePackagesWithLockFile Condition="'$(RuntimeIdentifier)' == ''">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(BaseIntermediateOutputPath)packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <!-- One static executable for any x64 Linux, the old kernel included: published for linux-musl-x64 in Alpine, as the forge
       is. Invariant globalization, so no ICU; OpenSSL linked in for TLS. -->
  <PropertyGroup Condition="'$(GraftRunnerStatic)' == 'true'">
    <PublishAot>true</PublishAot>
    <StaticExecutable>true</StaticExecutable>
    <StaticOpenSslLinking>true</StaticOpenSslLinking>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Graft.Contracts/Graft.Contracts.csproj" />
    <ProjectReference Include="../Graft.RunnerProtocol/Graft.RunnerProtocol.csproj" />
    <!-- The visiting side of a CupriNet Shrine only: no overlay, no listener. See ADR 0037. -->
    <PackageReference Include="CupriNet.Shrine" Version="0.6.2" />
    <PackageReference Include="CupriNet.Alembic.BouncyCastle" Version="0.6.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>
</Project>
