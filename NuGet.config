<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for Graft. DnaX, CupriNet and CupriMark come from Wixely's GitHub Packages feed; everything else
  from nuget.org.

  NO CREDENTIALS ARE STORED HERE. The feed needs a token with `read:packages`; supply it out-of-band and never commit
  it. Once per machine, add the source with your credential to your user-level NuGet configuration under the same
  name the other Wixely repositories use, GitHub-Wixely-Packages; docs/build-and-test.md has the command. The release
  workflow authenticates the source with `dotnet nuget update source` and the workflow's own token.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="GitHub-Wixely-Packages">
      <package pattern="DnaX.*" />
      <package pattern="CupriNet.*" />
      <package pattern="CupriMark" />
      <package pattern="CupriMark.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
