<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Seeded into the disposable repository so the project page has a README to render. The image is the
         one already in the documentation, so the fixture shows a real picture resolving out of the
         repository rather than a synthetic placeholder. -->
    <EmbeddedResource Include="Fixtures/README.md" LogicalName="fixture/README.md" />
    <EmbeddedResource Include="../../docs/assets/graft-readme-blue.png" LogicalName="fixture/graft-readme-blue.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Graft.Core/Graft.Core.csproj" />
    <ProjectReference Include="../../src/Graft.Git/Graft.Git.csproj" />
    <ProjectReference Include="../../src/Graft.Storage/Graft.Storage.csproj" />
    <ProjectReference Include="../../src/Graft.Server/Graft.Server.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
